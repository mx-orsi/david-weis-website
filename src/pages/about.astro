---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Story from '../components/Story.astro';
import Chapter from '../components/Chapter.astro';
import Lightbox from '../components/Lightbox.astro';
import Testimonials from '../components/Testimonials.astro';
import StatRow from '../components/StatRow.astro';
import Icon from '../components/Icon.astro';
import { about, aboutChapterA, aboutChapterB } from '../data/about';
import { withBase } from '../lib/paths';

// A different portrait from the home hero, so the two pages do not open the same way.
const portrait = {
  suggestion: 'Portrait of David in front of the Querencia Palms mural',
  src: '/images/querencia-palms/querencia-palms-fire-pits-outdoor-gathering-space-david-weis.jpg',
  alt: 'David Weis in a black shirt beside a table lamp, in front of a painted mural in blue, green and orange',
  width: 1365,
  height: 2048,
  hasSmall: true,
  position: 'center 30%',
};
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <PageHero eyebrow={about.hero.eyebrow} title={about.hero.title} intro={about.hero.intro} size="display">
    <Media slot="media" photo={portrait} ratio="4 / 5" priority sizes="(min-width: 960px) 40vw, 100vw" class="ab-portrait" />
  </PageHero>

  <div class="container ab-stats">
    <StatRow stats={about.stats} />
  </div>

  <div class="ab-body">
    <Chapter chapter={aboutChapterA} slug="about" />

    <section aria-labelledby="ab-career">
      <div class="container">
        <div class="ab-career__head">
          <p class="eyebrow eyebrow--dot">{about.career.eyebrow}</p>
          <h2 id="ab-career" class="title-lg ab-career__title">{about.career.heading}</h2>
        </div>
        <div class="ab-chapters">
          {about.career.items.map((item) => (
            <div class="ab-chapter">
              <h3 class="title-md">{item.title}</h3>
              {item.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          ))}
        </div>
      </div>
    </section>

    <Chapter chapter={aboutChapterB} slug="about" />
  </div>

  <Testimonials limit={4} variant="full" />

  <section class="section section--line" aria-labelledby="ab-close">
    <div class="container ab-close">
      <Story eyebrow={about.closing.eyebrow} heading={about.closing.title} paragraphs={about.closing.paragraphs} id="ab-close">
        <div class="ab-close__ctas">
          <a class="btn" href={withBase(about.closing.cta.href)}>{about.closing.cta.label} <Icon name="arrow-right" /></a>
          <a class="link-arrow" href={withBase(about.closing.ctaSecondary.href)}>{about.closing.ctaSecondary.label} <Icon name="arrow-right" /></a>
        </div>
      </Story>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .ab-stats {
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .ab-body {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }

  .ab-career__head {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .ab-career__title {
    max-width: 14ch;
  }
  .ab-chapters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .ab-chapter {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
  }
  .ab-chapter p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .ab-close {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 44rem;
  }
  .ab-close :global(.story__title) {
    max-width: 20ch;
  }
  .ab-close__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 899px) {
    .ab-chapters {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
