---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Page not found | David Weis" description="That page doesn't exist. Head back to the home page for San Diego, Palm Springs and Big Bear real estate." noindex finalCta={false}>
  <section class="nf section" aria-labelledby="nf-title">
    <div class="container nf__inner">
      <p class="eyebrow eyebrow--dot">404</p>
      <h1 id="nf-title" class="title-xl">That page isn't on the map.</h1>
      <p class="lede lede--wide">The link may be old or mistyped. The markets, the projects and a way to reach David are all one click away.</p>
      <div class="nf__actions">
        <a class="btn" href={withBase('/')}>Back to home <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href={withBase('/experience')}>Explore My Experience</a>
        <a class="btn btn--ghost" href={withBase('/contact')}>Work With David</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 44rem;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
