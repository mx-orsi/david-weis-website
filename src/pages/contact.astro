---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import Title from '../components/Title.astro';
import { agent, social } from '../data/site';
import { contact } from '../data/contact';

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${agent.brokerage} ${agent.office.street}, ${agent.office.city}, ${agent.office.state} ${agent.office.zip}`)}`;
const socialLinks = social.filter((s) => s.href);
---

<BaseLayout title={contact.seo.title} description={contact.seo.description} finalCta={false}>
  <PageHero eyebrow={contact.hero.eyebrow} title={contact.hero.title} intro={contact.hero.intro} size="display" />

  <section class="ct section section--flush-top" aria-label="Contact David">
    <div class="container ct__grid">
      <div class="ct__form">
        <h2 class="title-md">{contact.form.title}</h2>
        <p class="ct__body">{contact.form.body}</p>
        <ContactForm />
      </div>

      <aside class="ct__aside">
        <address class="ct-card">
          <p class="eyebrow eyebrow--muted">Direct</p>
          <ul class="ct-card__list">
            <li>
              <Icon name="phone" size={16} />
              <span><a href={agent.phoneHref}>{agent.phone}</a><small>Call or text</small></span>
            </li>
            <li>
              <Icon name="mail" size={16} />
              <span><a href={`mailto:${agent.email}`}>{agent.email}</a><small>Email</small></span>
            </li>
            <li>
              <Icon name="pin" size={16} />
              <span>
                {agent.brokerage}<br />{agent.office.street}<br />{agent.office.city}, {agent.office.state} {agent.office.zip}
                <a class="ct-card__map" href={mapsHref} target="_blank" rel="noopener noreferrer">Directions <Icon name="arrow-ext" size={11} /><span class="sr-only">(opens in a new tab)</span></a>
              </span>
            </li>
          </ul>
          <p class="ct-card__meta">{agent.name} · <Title /> · CA DRE #{agent.dre}</p>
        </address>
        {socialLinks.length > 0 && (
          <ul class="ct__social" aria-label="Social">
            {socialLinks.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={15} /> {s.name}<span class="sr-only"> (opens in a new tab)</span></a>
              </li>
            ))}
          </ul>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .ct__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-top: clamp(1rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .ct__form {
    display: grid;
    gap: 1rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ct__body {
    color: var(--ink-2);
    max-width: 48ch;
    margin-bottom: 0.75rem;
  }
  .ct__aside {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ct-card {
    font-style: normal;
    display: grid;
    gap: 1.25rem;
  }
  .ct-card__list {
    list-style: none;
    display: grid;
    gap: 1.1rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .ct-card__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .ct-card__list svg {
    flex: none;
    margin-top: 0.3em;
    color: var(--blue);
  }
  .ct-card__list li > span {
    display: grid;
    gap: 0.1rem;
  }
  .ct-card__list small {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ct-card__list a {
    text-decoration: none;
  }
  .ct-card__list a:hover {
    color: var(--blue);
  }
  .ct-card__map {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .ct-card__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .ct__social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .ct__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5em 0.9em;
    border: 1px solid var(--line-control);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
  }
  .ct__social a:hover {
    border-color: var(--blue);
    color: var(--blue);
  }
  @media (max-width: 899px) {
    .ct__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
