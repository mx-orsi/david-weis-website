---
import BaseLayout from '../layouts/BaseLayout.astro';
import StubPage from '../components/StubPage.astro';
import Icon from '../components/Icon.astro';
import { agent } from '../data/site';

const title = 'Contact David Weis | Compass Broker Associate in La Jolla, CA';
const description =
  'Reach David Weis, Compass Broker Associate and REALTOR®, at 619-518-9246 or david@davidweis.net. Office: 7863 Girard Ave #210, La Jolla, CA 92037. Serving San Diego, Palm Springs and Big Bear Lake.';
---

<BaseLayout {title} {description}>
  <StubPage
    eyebrow="Contact"
    title="Let's start with a conversation"
    lede="Buying, selling or thinking about an investment in San Diego, Palm Springs or Big Bear? Call, text or email and I'll get back to you quickly."
  >
    <Fragment slot="actions">
      <a class="btn" href={agent.phoneHref}>Call {agent.phone}</a>
      <a class="btn btn--ghost" href={`mailto:${agent.email}`}>Email David</a>
    </Fragment>

    <address class="contact-card">
      <ul class="contact-card__list">
        <li>
          <Icon name="phone" size={16} />
          <a href={agent.phoneHref}>{agent.phone}</a>
        </li>
        <li>
          <Icon name="mail" size={16} />
          <a href={`mailto:${agent.email}`}>{agent.email}</a>
        </li>
        <li>
          <Icon name="mail" size={16} />
          <a href={`mailto:${agent.emailCompass}`}>{agent.emailCompass}</a>
        </li>
        <li>
          <Icon name="pin" size={16} />
          <span>
            {agent.brokerage}<br />
            {agent.office.street}<br />
            {agent.office.city}, {agent.office.state} {agent.office.zip}
          </span>
        </li>
      </ul>
      <ul class="contact-card__social" aria-label="Social">
        <li><a href={agent.social.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={15} /> Instagram</a></li>
        <li><a href={agent.social.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} /> LinkedIn</a></li>
        <li><a href={agent.social.facebook} target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={15} /> Facebook</a></li>
      </ul>
      <p class="contact-card__meta">{agent.title} · CA DRE #{agent.dre}</p>
    </address>
  </StubPage>
</BaseLayout>

<style>
  .contact-card {
    font-style: normal;
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .contact-card__list {
    list-style: none;
    display: grid;
    gap: 0.9rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.55;
  }
  .contact-card__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .contact-card__list svg {
    flex: none;
    margin-top: 0.3em;
    color: var(--muted);
  }
  .contact-card__list a {
    text-decoration: none;
  }
  .contact-card__list a:hover {
    text-decoration: underline;
  }
  .contact-card__social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .contact-card__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5em 0.9em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
  }
  .contact-card__social a:hover {
    border-color: var(--ink);
  }
  .contact-card__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
