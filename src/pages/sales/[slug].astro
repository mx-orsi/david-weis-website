---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SaleGallery from '../../components/SaleGallery.astro';
import SaleLightbox from '../../components/SaleLightbox.astro';
import SaleUnitTiles from '../../components/SaleUnitTiles.astro';
import Media from '../../components/Media.astro';
import { allSales, getSale, querenciaCaseStudy, saleHref, saleGroupsFor, saleLocation, salePhotosFor, salePreview, salesPage } from '../../data/sales';
import { salesUi } from '../../data/salesUi';
import { siteUrl } from '../../data/site';
import { photoExists } from '../../lib/images';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return allSales.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const sale = getSale(slug!);
const isCase = sale.slug === querenciaCaseStudy.slug;
const q = isCase ? querenciaCaseStudy : undefined;

const idx = allSales.findIndex((s) => s.slug === sale.slug);
const prev = allSales[(idx - 1 + allSales.length) % allSales.length];
const next = allSales[(idx + 1) % allSales.length];

const photos = salePhotosFor(sale.slug).filter((p) => photoExists(p.src));
const [lead, ...rest] = photos;
const groups = saleGroupsFor(sale.slug)
  .map((g) => ({ ...g, photos: g.photos.filter((p) => photoExists(p.src)) }))
  .filter((g) => g.photos.length > 0);
// Querencia: the unit tiles replace the general gallery. Other stories: grouped when groups exist.
const showUnits = !!q && q.units.length > 0;
const galleryPhotos = showUnits || groups.length > 0 ? [] : rest;
const toSet = (list: readonly { src?: string; alt?: string }[]) =>
  list.map((p) => ({ src: p.src!, alt: p.alt ?? '' }));
const sets: Record<string, { src: string; alt: string }[]> = {};
if (galleryPhotos.length) sets.gallery = toSet(galleryPhotos);
for (const g of groups) sets[`${showUnits ? 'unit' : 'group'}-${g.id}`] = toSet(g.photos);
const hasLightbox = Object.keys(sets).length > 0;
const closedLine = sale.closed ? `${salesUi.closedWord} ${sale.closed}` : '';
const role = [sale.role, sale.roleNote].filter(Boolean).join(' · ');
const result = [sale.result, sale.resultNote].filter(Boolean).join(' · ');

const trim = (text: string, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max + 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:.\s]+$/, '') + '…';
};
const title = `${sale.title}, ${sale.city} | ${sale.role} | David Weis`;
const description = trim(salePreview(sale));

const links: { href: string; label: string }[] = [];
if (sale.project) links.push({ href: `/experience/${sale.project.slug}`, label: sale.project.label });
if (sale.related) links.push({ href: `/sales/${sale.related.slug}`, label: sale.related.label });

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: salesUi.home, item: siteUrl },
    { '@type': 'ListItem', position: 2, name: salesPage.title, item: `${siteUrl}/sales` },
    { '@type': 'ListItem', position: 3, name: sale.title, item: `${siteUrl}${saleHref(sale)}` },
  ],
};
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

  <article class="sd">
    <header class="sd-hero" aria-labelledby="page-title">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={withBase('/')}>{salesUi.home}</a>
          <span aria-hidden="true">/</span>
          <a href={withBase('/sales')}>{salesPage.title}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{sale.title}</span>
        </nav>
        <p class="eyebrow eyebrow--dot">{role}</p>
        <h1 id="page-title" class="title-xl">{sale.title}</h1>
        <p class="sd-hero__city">{saleLocation(sale)}{q && <> · {q.subtitle}</>}</p>
        {q ? (
          <ul class="sd-hero__stats" aria-label="Highlights">
            {q.highlights.map((h) => <li>{h}</li>)}
          </ul>
        ) : (
          <p class="sd-hero__result">{result}{closedLine && <span class="sd-hero__closed"> · {closedLine}</span>}</p>
        )}
        {q && (
          <div class="sd-phases">
            <h2 class="eyebrow eyebrow--muted">{salesUi.closedResidences}</h2>
            <ul>
              {q.phases.map((ph, i) => (
                <li>{ph.name}: {ph.units.length === 1 ? 'Unit' : 'Units'} {ph.units.join(', ')}{i === q.phases.length - 1 && q.phasesNote ? `, ${q.phasesNote}` : ''}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </header>

    {lead && (
      <div class="container sd-lead">
        <Media photo={lead} ratio="16 / 9" sizes="100vw" priority />
      </div>
    )}

    <section class="sd-story section" aria-label="Story">
      <div class="container">
        <div class="prose">
          {sale.paragraphs.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </section>

    {showUnits && q && (
      <section class="sd-units section section--flush-top" aria-labelledby="sd-units-title">
        <div class="container">
          <h2 id="sd-units-title" class="title-lg">{salesUi.soldResidences}</h2>
          <SaleUnitTiles units={q.units} groups={groups} headingId="sd-units-title" />
        </div>
      </section>
    )}

    {galleryPhotos.length > 0 && (
      <section class="sd-gallery section section--flush-top" aria-label={salesUi.photos}>
        <div class="container">
          <SaleGallery photos={galleryPhotos} set="gallery" label={salesUi.photos} />
        </div>
      </section>
    )}

    {!showUnits && groups.length > 0 && (
      <section class="sd-groups section section--flush-top" aria-label={salesUi.photos}>
        <div class="container">
          {groups.map((g) => (
            <div class="sd-group">
              <div class="sd-group__head">
                <h2 class="sd-group__title">{g.label}</h2>
                {g.note && <p class="sd-group__note">{g.note}</p>}
              </div>
              <SaleGallery photos={g.photos} set={`group-${g.id}`} label={g.label} />
            </div>
          ))}
        </div>
      </section>
    )}

    {links.length > 0 && (
      <section class="sd-links section section--flush-top" aria-labelledby="sd-links-title">
        <div class="container">
          <h2 id="sd-links-title" class="eyebrow eyebrow--muted">{salesUi.moreHeading}</h2>
          <ul>
            {links.map((l) => (
              <li><a class="link-arrow" href={withBase(l.href)}>{l.label} <Icon name="arrow-right" /></a></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>

  <footer class="sd-foot">
    <div class="container sd-foot__inner">
      <a class="link-arrow" href={withBase('/sales')}>{salesUi.allSales} <Icon name="arrow-right" /></a>
      <nav class="sd-foot__nav" aria-label={salesUi.nav}>
        <a class="sd-foot__link" href={withBase(saleHref(prev))} rel="prev">
          <span class="sd-foot__k"><Icon name="arrow-left" size={12} /> {salesUi.previous}</span>
          <span class="sd-foot__name">{prev.title}</span>
        </a>
        <a class="sd-foot__link sd-foot__link--next" href={withBase(saleHref(next))} rel="next">
          <span class="sd-foot__k">{salesUi.next} <Icon name="arrow-right" size={12} /></span>
          <span class="sd-foot__name">{next.title}</span>
        </a>
      </nav>
    </div>
  </footer>

  {hasLightbox && <SaleLightbox {sets} />}
</BaseLayout>

<style>
  .sd-hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .sd-hero .container {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .sd-hero h1 {
    max-width: 16ch;
  }
  .sd-hero__city {
    color: var(--muted);
    font-size: 1.0625rem;
  }
  .sd-hero__result {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-strong);
    width: 100%;
    text-wrap: balance;
  }
  .sd-hero__stats {
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--line-strong);
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem 2.5rem;
  }
  .sd-hero__stats li {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
    font-weight: 500;
    line-height: 1.1;
    text-wrap: balance;
  }
  .sd-phases {
    display: grid;
    gap: 0.5rem;
  }
  .sd-phases ul,
  .sd-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .sd-phases li {
    color: var(--ink-2);
  }
  .sd-hero__closed {
    color: var(--muted);
    font-size: 0.55em;
    letter-spacing: 0;
  }
  .sd-units .container,
  .sd-groups .container {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .sd-groups .container {
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .sd-group {
    display: grid;
    gap: 1.25rem;
  }
  .sd-group__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }
  .sd-group__title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 500;
    line-height: 1.1;
  }
  .sd-group__note {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .sd-lead {
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  .sd-links .container {
    display: grid;
    gap: 1rem;
  }
  .sd-foot {
    border-top: 1px solid var(--line-strong);
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .sd-foot__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .sd-foot__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
  }
  .sd-foot__link {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }
  .sd-foot__link--next {
    text-align: right;
    justify-items: end;
  }
  .sd-foot__k {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sd-foot__name {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.15;
  }
  .sd-foot__link:hover .sd-foot__name {
    color: var(--blue);
  }
</style>
