 */
import LegalDoc from '../components/LegalDoc.astro';
import Title from '../components/Title.astro';
import { agent } from '../data/site';
import { withBase } from '../lib/paths';

const title = 'Privacy Policy | David Weis';
const description = 'Privacy policy for davidweis.com: what information the site collects through its contact form, how it is used and the choices you have.';
const updated = 'October 11, 2026';
---

<LegalDoc {title} {description} heading="Privacy Policy" {updated}>
  <div class="pp__todo" slot="todo">
    <strong>Before launch:</strong> Compass compliance must approve this policy (ideally counsel too). Then remove this box.
    <ul>
      <li>[confirm: which form service will receive contact form messages (Formspree, Basin or other), so it can be named]</li>
      <li>[confirm: whether Google Analytics 4 or a Compass pixel will be enabled; if yes, swap in the commented paragraph in the Analytics section]</li>
      <li>[confirm: iHomeFinder go-live date and what its registration collects; remove the "once the search is live" note then]</li>
      <li>[confirm: whether leads really route through Zapier to the Compass CRM]</li>
    </ul>
  </div>

  <p class="lede lede--wide">This policy explains what information is collected through davidweis.com, why, and what choices you have.</p>

      <h2>Who we are</h2>
      <p>
        This website is operated by {agent.name}, a licensed real estate <Title /> in the State of California (DRE #{agent.dre}),
        affiliated with {agent.brokerage} (DRE #{agent.brokerageDre}). You can reach us at
        <a href={`mailto:${agent.email}`}>{agent.email}</a> or <a href={agent.phoneHref}>{agent.phone}</a>.
      </p>

      <h2>What we collect</h2>
      <ul>
        <li>
          <strong>Information you give us.</strong> Your name, email address, phone number, what you are interested in, the location
          you select and anything you write in the message field of the contact form.
        </li>
        <li>
          <strong>Information collected automatically.</strong> Standard server log data such as IP address, browser and device
          type, pages viewed and referring URL. See "Hosting" and "Analytics and tracking" below.
        </li>
      </ul>
      <p>
        We do not knowingly collect information from anyone under 16, and we do not ask for Social Security numbers, financial
        account numbers or other sensitive identifiers through this website.
      </p>

      <h2>How we use it</h2>
      <ul>
        <li>To respond to your inquiry and provide real estate brokerage services.</li>
        <li>To send you property information or market updates you asked for.</li>
        <li>To improve how this site works.</li>
        <li>To meet legal, regulatory and brokerage record-keeping obligations.</li>
      </ul>
      <p><strong>We do not sell or rent your personal information.</strong></p>

      <h2>Who we share it with</h2>
      <p>
        We share information only with service providers who help operate this business: the form service that delivers your
        message to us, iHomeFinder (which runs the property search), Zapier (which can relay leads to our customer relationship
        management system), and {agent.brokerage}, our responsible broker, where required for a transaction or by brokerage
        policy. We may also disclose information where required by law. We do not sell your information.
      </p>

      <h2>Your California privacy rights</h2>
      <p>
        Under the California Consumer Privacy Act, as amended by the CPRA, California residents have the right to know what personal
        information we collect and how it is used, to request deletion, to request correction, to opt out of sale or sharing (we do
        neither), to limit the use of sensitive personal information, and not to receive discriminatory treatment for exercising
        these rights. To make a request, email <a href={`mailto:${agent.email}`}>{agent.email}</a> or call
        <a href={agent.phoneHref}>{agent.phone}</a>. We will verify your identity before acting on the request.
      </p>

      <h2>Text messages and mobile information</h2>
      <p>
        No mobile information will be shared with third parties/affiliates for marketing/promotional purposes. All the above
        categories exclude text messaging originator opt-in data and consent; this information will not be shared with any third
        parties.
      </p>
      <p>
        If you give us your phone number, the contact form asks you to agree to be contacted by call, email and text. We text only
        people who have agreed. To stop texts, reply STOP at any time. For help, reply HELP. Message and data rates may apply, and
        message frequency may vary. You can also email <a href={`mailto:${agent.email}`}>{agent.email}</a> to opt out.
      </p>
      <p>We keep a record of your consent, and we never share it.</p>

      <h2>Property search and saved searches</h2>
      <p><em>This section applies once the property search is live on this site.</em></p>
      <p>
        The property search is operated by iHomeFinder. When you register, it collects what you enter, usually your name, email
        address and phone number, plus the searches you save, the homes you favorite and how you use the search. iHomeFinder and
        {agent.brokerage} receive your lead details so we can follow up. Zapier may relay those details to our customer
        relationship management system at {agent.brokerage}. We do not sell this information. iHomeFinder handles it under its own
        privacy policy as well.
      </p>

      <h2>Analytics and tracking</h2>
      <p>
        This site does not currently use analytics or advertising pixels. If that changes, we will update this section before the
        tools are turned on.
      </p>
      {/*
        READY-TO-USE TEXT for when Google Analytics 4 and/or a Compass pixel are enabled. Replace the paragraph above with this,
        then update the "Cookies" note and the blue box.

        <p>
          This site uses Google Analytics 4 to count visits and see which pages are useful. It collects your IP address (shortened
          where possible), device and browser type, pages viewed and referring site, using cookies or similar technologies. It
          does not collect your name or contact details. [If used:] The site also uses a Compass tracking pixel, which tells Compass
          that you visited and which pages you viewed, so Compass can measure and improve its services and show relevant ads.
        </p>
        <p>
          To opt out of Google Analytics, install the
          <a href="https://tools.google.com/dlpage/gaoptout">Google Analytics opt-out browser add-on</a>, or block cookies in your
          browser settings. You can also turn on the Global Privacy Control signal in your browser, which we will honor. To opt out
          of the Compass pixel, email {agent.email} or use the opt-out controls on compass.com. We do not sell your information, and
          you can ask us to stop sharing it for advertising at any time.
        </p>
      */}

      <h2>Cookies</h2>
      <p>
        The site itself needs no cookies to work. The property search and any tools we add later may set cookies. Most browsers
        let you refuse or delete cookies; doing so may affect how parts of the site work.
      </p>

      <h2>Hosting</h2>
      <p>
        The site is hosted on Cloudflare Pages (during preview, GitHub Pages). Like most hosts, they keep standard server logs such
        as IP address, browser type and the pages requested, to deliver the site and keep it secure.
      </p>

      <h2>Fair housing</h2>
      <p>
        We are committed to equal housing opportunity. {agent.brokerage} abides by Equal Housing Opportunity laws, and we
        treat everyone fairly and honestly. See our <a href={withBase('/terms')}>Terms of Use</a> for more.
      </p>

      <h2>Security and retention</h2>
      <p>
        We use reasonable safeguards to protect the information we hold and keep it only as long as needed for the purposes above
        or as required by law and brokerage record-keeping rules. No method of transmission over the internet is completely secure.
      </p>

      <h2>Third-party links</h2>
      <p>This site links to other websites, including compass.com. We are not responsible for their privacy practices.</p>

      <h2>Changes</h2>
      <p>We may update this policy. The revised version will be posted here with a new "last updated" date.</p>

      <h2>Contact</h2>
      <p>
        {agent.name}, <Title /><br />
        {agent.brokerage}, {agent.office.street}, {agent.office.city}, {agent.office.state} {agent.office.zip}<br />
        <a href={`mailto:${agent.email}`}>{agent.email}</a> · <a href={agent.phoneHref}>{agent.phone}</a>
      </p>
</LegalDoc>
