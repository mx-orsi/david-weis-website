---
import BaseLayout from '../layouts/BaseLayout.astro';
import StubPage from '../components/StubPage.astro';
import { withBase } from '../lib/paths';

const title = 'Projects | Querencia Palms, The Cole Hotel & Big Bear Cabin | David Weis';
const description =
  'Development and investment projects by David Weis across Palm Springs, San Diego and Big Bear Lake, including the Querencia Palms condo conversion, The Cole Hotel and a Big Bear cabin rebuild.';

const projects = [
  {
    market: 'Palm Springs',
    name: 'Querencia Palms',
    text: 'A condo conversion I helped my husband complete and bring into the community. Phases I and II sold out: eight of eight escrows opened at full-price offers, six units closed, and the first Phase III unit is already in escrow at full ask.',
  },
  {
    market: 'Palm Springs',
    name: 'The Cole Hotel',
    text: 'Co-developed with my husband and operated as General Manager, earning five-star ratings across every platform.',
  },
  {
    market: 'Palm Springs',
    name: 'Six-bedroom vacation rental',
    text: 'Owned and operated as a short-term rental, with hands-on experience in the local STR rules.',
  },
  {
    market: 'Big Bear Lake',
    name: 'Cabin rebuild',
    text: 'The first home I bought on my own, near Big Bear Mountain Resort, which my husband and I then rebuilt.',
  },
  {
    market: 'San Diego',
    name: 'Short-term rentals',
    text: 'Three rentals I own and manage in Mission Beach, Ocean Beach and Kensington. Bookings run through Celebrity Vacation Homes, a separate business from my Compass brokerage work.',
  },
];
---

<BaseLayout {title} {description}>
  <StubPage
    eyebrow="Projects"
    title="Built, rebuilt and operated"
    lede="Hotel, condo conversion, cabin rebuild and short-term rentals across all three markets. The advice I give clients comes from doing this work myself."
  >
    <Fragment slot="actions">
      <a class="btn" href={withBase('/contact')}>Talk about a project</a>
    </Fragment>
    <ul class="projects">
      {
        projects.map((p) => (
          <li class="projects__item">
            <span class="eyebrow">{p.market}</span>
            <strong class="projects__name">{p.name}</strong>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </StubPage>
</BaseLayout>

<style>
  .projects {
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }
  .projects__item {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .projects__name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
  }
  .projects__item p {
    font-size: 0.875rem;
    color: var(--ink-2);
  }
</style>
