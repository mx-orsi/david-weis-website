---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCase from '../components/ProjectCase.astro';
import CtaBand from '../components/CtaBand.astro';
import PcbTrace from '../components/PcbTrace.astro';
import { projects, projectStats } from '../data/projects';
import { withBase } from '../lib/paths';

const title = 'Projects | Querencia Palms, The Cole Hotel & Big Bear Cabin | David Weis';
const description =
  'Development and investment projects by David Weis across Palm Springs, San Diego and Big Bear Lake: the Querencia Palms condo conversion, The Cole Hotel restoration, a Big Bear cabin rebuild and short-term rentals he owns and operates.';
const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<BaseLayout {title} {description}>
  <section class="pr-hero" aria-labelledby="pr-title">
    <div class="container pr-hero__grid">
      <div class="pr-hero__copy">
        <p class="eyebrow eyebrow--dot">Projects</p>
        <h1 id="pr-title">Built, rebuilt and operated</h1>
        <p class="lede">
          A condo conversion, a boutique hotel, a cabin rebuild and the rentals I run myself, across all
          three markets. The advice I give clients comes from doing this work with my own money.
        </p>
        <div class="pr-hero__actions">
          <a class="btn" href={withBase('/contact')}>Talk about a project</a>
          <a class="link-arrow" href="#querencia-palms">Start with Querencia Palms <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <ul class="pr-stats" aria-label="By the numbers">
        {projectStats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pr-list section" aria-label="Projects">
    <div class="container">
      {featured.map((p) => <ProjectCase project={p} />)}
      <div class="pr-list__rest">
        {rest.map((p, i) => <ProjectCase project={p} flip={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  <div class="container"><PcbTrace variant="divider" /></div>
  <CtaBand
    tone="light"
    eyebrow="Have a project in mind?"
    title="From a first cabin to a condo conversion"
    body="I've been on the owner's side of the table for all of it. Tell me what you're weighing and I'll tell you what I'd do with my own money."
  />
</BaseLayout>

<style>
  .pr-hero {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  .pr-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .pr-hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .pr-hero__copy h1 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    max-width: 14ch;
  }
  .pr-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 0.25rem;
  }
  .pr-stats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pr-stats li {
    display: grid;
    gap: 0.35rem;
    padding: 1.4rem 1.4rem 1.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .pr-stats strong {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 500;
    line-height: 1;
  }
  .pr-stats span {
    font-size: 0.8125rem;
    color: var(--ink-2);
    line-height: 1.4;
  }
  .pr-list {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .pr-list__rest {
    margin-top: clamp(1rem, 3vw, 2rem);
  }
  @media (max-width: 899px) {
    .pr-hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .pr-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
