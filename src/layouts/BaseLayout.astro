---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalCta from '../components/FinalCta.astro';
import { agent, siteUrl, social } from '../data/site';
import { integrations } from '../data/integrations';
import { withBase, isPreviewBuild } from '../lib/paths';

interface Props {
  /** Full <title>. Keep unique per page, ideally under ~65 characters. */
  title: string;
  /** Unique meta description, ideally 120–160 characters. */
  description: string;
  /** Path or absolute URL for the social share image. */
  ogImage?: string;
  /** Description of a page-specific share image (falls back to the page title). */
  ogImageAlt?: string;
  noindex?: boolean;
  /** The sitewide "Real estate rarely gives you only one option." band before the footer. */
  finalCta?: boolean;
  /** Open Graph type: "article" for the guides, "website" everywhere else. */
  ogType?: 'website' | 'article';
}

const DEFAULT_OG = '/images/david-weis-share-image.jpg';
const { title, description, ogImage = DEFAULT_OG, ogImageAlt, noindex = false, finalCta = true, ogType = 'website' } = Astro.props;
// David's 2026-10-12 review: a page's own share image gets its own description,
// never the headshot's; only the default 1200×630 card declares its size.
const isDefaultOg = ogImage === DEFAULT_OG;
const ogAlt = isDefaultOg ? `The ${agent.name} logo beside a portrait of ${agent.name}` : (ogImageAlt ?? title);

/** GA4 runs on production only, so preview visits never count. */
const gaId = isPreviewBuild ? '' : integrations.gaMeasurementId;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteUrl);
const ogImageURL = new URL(withBase(ogImage), Astro.site ?? siteUrl);

/**
 * RealEstateAgent structured data, rendered on every page so search engines
 * see consistent name / address / phone and license details site-wide.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${siteUrl}/#agent`,
  name: agent.name,
  alternateName: `${agent.name}, ${agent.title}`,
  description:
    'Compass Broker Associate representing buyers and sellers across San Diego, Palm Springs and Big Bear, with firsthand experience in ownership, investment, renovation, hospitality and vacation rental operations.',
  url: siteUrl,
  image: new URL(agent.headshot.src, siteUrl).href,
  telephone: agent.phoneE164,
  email: agent.email,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'California DRE License',
    value: agent.dre,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: agent.office.street,
    addressLocality: agent.office.city,
    addressRegion: agent.office.state,
    postalCode: agent.office.zip,
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'City', name: 'San Diego', sameAs: 'https://en.wikipedia.org/wiki/San_Diego' },
    { '@type': 'City', name: 'Palm Springs', sameAs: 'https://en.wikipedia.org/wiki/Palm_Springs,_California' },
    { '@type': 'City', name: 'Big Bear Lake', sameAs: 'https://en.wikipedia.org/wiki/Big_Bear_Lake,_California' },
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: agent.brokerage,
    url: agent.brokerageUrl,
    identifier: { '@type': 'PropertyValue', propertyID: 'California DRE License', value: agent.brokerageDre },
  },
  employee: {
    '@type': 'Person',
    name: agent.name,
    jobTitle: agent.title,
    telephone: agent.phoneE164,
    email: agent.email,
  },
  sameAs: [agent.compassProfile, ...social.filter((s) => s.href).map((s) => s.href)],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {(noindex || isPreviewBuild) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/favicon-32.png')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${agent.name} · ${agent.title} · ${agent.brokerage}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", gaId);
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {finalCta && <FinalCta />}
    <Footer />
  </body>
</html>
