---
/**
 * ListingCard — one property card for the Properties page (for sale or
 * sold). Fields come from src/data/listings.ts; placeholder entries render
 * with a visible "Placeholder" tag until real listings are entered.
 */
import Icon from './Icon.astro';
import Media from './Media.astro';
import type { Listing } from '../data/listings';
import { agent } from '../data/site';

interface Props {
  listing: Listing;
  /** CTA label; omit for sold cards */
  cta?: string;
}
const { listing: l, cta } = Astro.props;
const href = l.href ?? agent.compassProfile;
const facts = [
  { v: l.beds, k: 'Beds' },
  { v: l.baths, k: 'Baths' },
  { v: l.sqft, k: 'Sq ft' },
];
---

<article class:list={['lc', l.placeholder && 'lc--placeholder']} aria-label={`${l.address}, ${l.city}`}>
  <div class="lc__media">
    <Media photo={l.photo} ratio="4 / 3" sizes="(min-width: 1024px) 33vw, (min-width: 700px) 50vw, 100vw" />
    <span class="lc__status">{l.status}</span>
    {l.placeholder && <span class="lc__tag">Placeholder</span>}
  </div>
  <div class="lc__body">
    <p class="lc__price">{l.price}</p>
    <h3 class="lc__address">{l.address}</h3>
    <p class="lc__city">{l.city}</p>
    <dl class="lc__facts">
      {facts.map((f) => (
        <div>
          <dd>{f.v}</dd>
          <dt>{f.k}</dt>
        </div>
      ))}
    </dl>
    {cta && (
      <a class="link-arrow link-arrow--ext" href={href} target="_blank" rel="noopener noreferrer">
        {cta} <Icon name="arrow-ext" /><span class="sr-only">(opens Compass in a new tab)</span>
      </a>
    )}
  </div>
</article>

<style>
  .lc {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
  }
  .lc__media {
    position: relative;
  }
  .lc__status,
  .lc__tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.4em 0.75em;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .lc__status {
    left: 0.75rem;
    background: var(--ink);
    color: var(--on-ink);
  }
  .lc__tag {
    right: 0.75rem;
    background: var(--blue);
    color: var(--on-ink);
  }
  .lc__body {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-strong);
  }
  .lc__price {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.1;
  }
  .lc__address {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .lc__city {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .lc__facts {
    display: flex;
    gap: 1.5rem;
    margin: 0.5rem 0 0.35rem;
  }
  .lc__facts div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
  }
  .lc__facts dd {
    margin: 0;
    font-size: 1rem;
    font-weight: 400;
    color: var(--ink);
  }
  .lc__facts dt {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lc--placeholder .lc__price,
  .lc--placeholder .lc__address {
    color: var(--muted);
  }
</style>
