---
/**
 * MarketPage — the shared template for San Diego, Palm Springs and Big Bear.
 * Content comes from src/data/marketPages.ts and site.ts; featured projects
 * are pulled from projects.ts so cards stay in sync.
 */
import Icon from './Icon.astro';
import Media from './Media.astro';
import Story from './Story.astro';
import AreaCard from './AreaCard.astro';
import ProjectCard from './ProjectCard.astro';
import SearchCTA from './SearchCTA.astro';
import { getMarket, siteUrl, type MarketSlug } from '../data/site';
import { marketPages } from '../data/marketPages';
import { getProject } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props {
  slug: MarketSlug;
}
const { slug } = Astro.props;
const m = getMarket(slug);
const c = marketPages[slug];
const featured = c.featuredProjects.map(getProject);
const [first, ...restSections] = c.sections;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: m.name, item: `${siteUrl}${m.href}` },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />

<article class="mp">
  <header class="mp-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{m.name}</span>
      </nav>
      <p class="eyebrow eyebrow--dot">{c.eyebrow}</p>
      <div class="mp-hero__grid">
        <h1 class="display">{c.title}</h1>
        <p class="lede lede--wide">{c.intro}</p>
      </div>
    </div>
    <div class="container mp-hero__lead">
      <Media photo={m.image} ratio="21 / 9" priority sizes="100vw" />
    </div>
  </header>

  <div class="mp-body">
    <section class="mp-section" aria-labelledby={`${slug}-s0`}>
      <div class="container">
        <Story heading={first.heading} paragraphs={first.paragraphs} layout="split" id={`${slug}-s0`} />
      </div>
    </section>

    <div class="container">
      <Media photo={c.photo} ratio="16 / 9" sizes="100vw" />
    </div>

    {restSections.map((s, i) => (
      <section class="mp-section" aria-labelledby={`${slug}-s${i + 1}`}>
        <div class="container">
          <Story heading={s.heading} paragraphs={s.paragraphs} layout="split" id={`${slug}-s${i + 1}`} />
        </div>
      </section>
    ))}

    {c.areas && (
      <section class="mp-areas" aria-labelledby={`${slug}-areas`}>
        <div class="container">
          <h2 id={`${slug}-areas`} class="title-lg">{c.areas.title}</h2>
          <ul class="mp-areas__grid">
            {c.areas.items.map((a) => <AreaCard area={a} />)}
          </ul>
        </div>
      </section>
    )}

    {featured.length > 0 && (
      <section class="mp-featured" aria-labelledby={`${slug}-featured`}>
        <div class="container">
          <div class="mp-featured__head">
            <h2 id={`${slug}-featured`} class="title-lg">{c.featuredTitle}</h2>
            <a class="link-arrow" href={withBase('/experience')}>All projects <Icon name="arrow-right" /></a>
          </div>
          <div class:list={['mp-featured__grid', featured.length === 1 && 'mp-featured__grid--single']}>
            {featured.map((p) => <ProjectCard project={p} variant={featured.length === 1 ? 'wide' : 'index'} />)}
          </div>
        </div>
      </section>
    )}
  </div>

  <section class="mp-cta" aria-label={`${m.name} properties`}>
    <div class="container mp-cta__inner">
      <SearchCTA market={slug} />
      <a class="btn btn--ghost" href={withBase('/contact')}>Work With David</a>
    </div>
  </section>
</article>

<style>
  .mp-hero {
    padding-block: clamp(3rem, 7vw, 6rem) 0;
  }
  .mp-hero .crumbs {
    margin-bottom: 1.5rem;
  }
  .mp-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: 1.25rem;
  }
  .mp-hero__lead {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .mp-body {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .mp-areas__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .mp-areas__grid > :global(li:nth-child(5)) {
    grid-column: 1 / -1;
    max-width: 44ch;
  }
  .mp-featured__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .mp-featured__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .mp-featured__grid--single {
    grid-template-columns: minmax(0, 1fr);
  }
  .mp-cta {
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .mp-cta__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 1023px) {
    .mp-areas__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .mp-hero__grid,
    .mp-featured__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .mp-areas__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .mp-cta__inner {
      flex-direction: column;
    }
    .mp-cta__inner :global(.btn) {
      width: 100%;
    }
  }
</style>
