---
/**
 * David Weis brand artwork, supplied by David (2026-09-08) and saved with a
 * transparent background in public/images/:
 *
 *   david-weis-realtor-logo.png             roof mark + signature (header)
 *   david-weis-realtor-logo-white.png       same, white, for dark backgrounds
 *   david-weis-realtor-compass-lockup.png   full lockup: mark, signature,
 *                                           title, markets and Compass (footer)
 *
 * Alt text carries the words so the artwork stays indexable and readable.
 */
import { withBase } from '../lib/paths';

interface Props {
  /** inline: header mark + signature. lockup: full footer lockup with Compass. */
  variant?: 'inline' | 'lockup';
  /** Use the white artwork on dark backgrounds (inline only) */
  tone?: 'ink' | 'white';
  class?: string;
}
const { variant = 'inline', tone = 'ink', class: className, ...rest } = Astro.props;
const art =
  variant === 'lockup'
    ? { src: '/images/david-weis-realtor-compass-lockup.png', w: 892, h: 749, alt: 'David Weis, Broker Associate | REALTOR® with Compass, serving San Diego, Palm Springs and Big Bear' }
    : tone === 'white'
      ? { src: '/images/david-weis-realtor-logo-white.png', w: 884, h: 428, alt: 'David Weis, REALTOR®' }
      : { src: '/images/david-weis-realtor-logo.png', w: 884, h: 428, alt: 'David Weis, REALTOR®' };
---

<span class:list={['logo', `logo--${variant}`, className]} {...rest}>
  <img class="logo__img" src={withBase(art.src)} alt={art.alt} width={art.w} height={art.h} decoding="async" />
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo__img {
    display: block;
    width: auto;
    height: 58px;
  }

  .logo--lockup .logo__img {
    height: auto;
    width: min(100%, 280px);
  }

  @media (max-width: 540px) {
    .logo--inline .logo__img {
      height: 48px;
    }
  }
</style>
