---
/**
 * David Weis REALTOR® lockup: the exact brand artwork (three-gable roof mark
 * plus the "David Weis" signature), lifted at 1080p from David's video end card
 * and saved with a transparent background in public/images/.
 *
 *   david-weis-logo-lockup.png        ink on transparent (light backgrounds)
 *   david-weis-logo-lockup-white.png  white on transparent (dark backgrounds)
 *   david-weis-roof-mark.png          roof mark only (favicons, small uses)
 *
 * Replace these with the client's vector file when supplied (see IMAGES-NEEDED.md).
 * The title line stays real text so it remains selectable and indexable.
 */
import { withBase } from '../lib/paths';

interface Props {
  variant?: 'inline' | 'stacked';
  /** Use the white artwork on dark backgrounds */
  tone?: 'ink' | 'white';
  class?: string;
}
const { variant = 'inline', tone = 'ink', class: className, ...rest } = Astro.props;
const stacked = variant === 'stacked';
const src = withBase(tone === 'white' ? '/images/david-weis-logo-lockup-white.png' : '/images/david-weis-logo-lockup.png');
---

<span class:list={['logo', `logo--${variant}`, className]} {...rest}>
  <img class="logo__img" src={src} alt="David Weis, REALTOR®" width="729" height="303" decoding="async" />
  {
    stacked && (
      <span class="logo__title">
        Broker Associate <span class="logo__sep">|</span> Realtor<sup>®</sup>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo__img {
    display: block;
    width: auto;
    height: 58px;
  }
  .logo__title {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .logo__title sup {
    font-size: 0.6em;
    letter-spacing: 0;
    vertical-align: top;
    line-height: 0;
  }
  .logo__sep {
    opacity: 0.45;
  }

  .logo--stacked {
    align-items: flex-start;
    gap: 0.9rem;
  }
  .logo--stacked .logo__img {
    height: 104px;
  }

  @media (max-width: 540px) {
    .logo--inline .logo__img {
      height: 48px;
    }
  }
</style>
