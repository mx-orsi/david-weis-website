---
/**
 * Compass wordmark, drawn as a vector from the logo the client supplied:
 * monoline geometric capitals with the compass needle inside the "O".
 *
 * This is a hand-traced approximation. If Compass provides an official SVG,
 * drop it in as an <img> here (or replace the paths) — the props stay the same.
 */
interface Props {
  class?: string;
}
const { class: className, ...rest } = Astro.props;
---

<svg
  class:list={['compass', className]}
  viewBox="0 0 860 120"
  role="img"
  aria-label="Compass"
  {...rest}
>
  <title>Compass</title>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="15"
    stroke-linejoin="miter"
    stroke-miterlimit="6"
    transform="translate(7.5 10)"
  >
    <!-- C -->
    <path d="M88.3 17.9 A50 50 0 1 0 88.3 82.1" />
    <!-- O with needle -->
    <circle cx="191" cy="50" r="50" />
    <path d="M176 65 L222 19" />
    <!-- M -->
    <path d="M288 100 V0 L338 64 L388 0 V100" />
    <!-- P -->
    <path d="M435 100 V0 H478 A27.5 27.5 0 0 1 478 55 H435" />
    <!-- A -->
    <path d="M552.5 100 L602.5 0 L652.5 100 M579 62 H626" />
    <!-- S S -->
    <path transform="translate(687.5 0)" d="M57.75 15.86 A24 24 0 1 0 36 50 A24 24 0 1 1 14.25 84.14" />
    <path transform="translate(782.5 0)" d="M57.75 15.86 A24 24 0 1 0 36 50 A24 24 0 1 1 14.25 84.14" />
  </g>
</svg>

<style>
  .compass {
    display: block;
    height: 21px;
    width: auto;
    color: var(--ink);
  }
</style>
