---
/**
 * Home hero. The only page-load motion on the site: the copy and portrait
 * settle in once (see .rise in global.css; disabled under reduced motion).
 */
import Icon from './Icon.astro';
import Title from './Title.astro';
import { agent } from '../data/site';
import { home } from '../data/home';
import { withBase } from '../lib/paths';
import { sizedVariant, webpVariant } from '../lib/images';

const h = home.hero;
const src = withBase(agent.headshot.src);
const small = withBase(sizedVariant(agent.headshot.src, 500));
const webp = webpVariant(agent.headshot.src);
const webpSmall = webpVariant(sizedVariant(agent.headshot.src, 500));
const webpSet = webp && webpSmall ? `${withBase(webpSmall)} 500w, ${withBase(webp)} 1000w` : undefined;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy rise">
      <p class="eyebrow eyebrow--dot">{h.eyebrow}</p>
      <h1 id="hero-title" class="display">{h.title}</h1>
      <p class="lede">{h.body}</p>
      <div class="hero__actions">
        <a class="btn" href={withBase(h.primary.href)}>{h.primary.label} <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href={withBase(h.secondary.href)}>{h.secondary.label}</a>
      </div>
    </div>

    <figure class="hero__portrait rise rise--late">
      <div class="hero__frame frame">
        <picture>
          {webpSet && <source type="image/webp" srcset={webpSet} sizes="(min-width: 960px) 40vw, 100vw" />}
          <img
            src={src}
            srcset={`${small} 500w, ${src} 1000w`}
            sizes="(min-width: 960px) 40vw, 100vw"
            alt={agent.headshot.alt}
            width={agent.headshot.width}
            height={agent.headshot.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <figcaption class="hero__caption">
        <span class="hero__caption-name">{agent.name}</span>
        <span class="hero__caption-title"><Title /> · {agent.brokerage}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .hero__copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }
  .hero__copy h1 {
    max-width: 10ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero__portrait {
    position: relative;
    justify-self: end;
    width: min(100%, 520px);
    display: grid;
    gap: 0.9rem;
  }
  .hero__frame {
    aspect-ratio: 4 / 5;
    box-shadow: 0 40px 80px -48px rgba(10, 11, 13, 0.45);
  }
  .hero__frame picture,
  .hero__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__frame img {
    object-position: 50% 20%;
  }
  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    align-items: baseline;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__caption-name {
    font-weight: 500;
    color: var(--ink);
  }

  @media (max-width: 959px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__portrait {
      order: -1;
      width: min(100%, 360px);
      justify-self: start;
    }
  }
  @media (max-width: 540px) {
    .hero__actions {
      width: 100%;
      flex-direction: column;
    }
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
