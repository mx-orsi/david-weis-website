---
import Icon from './Icon.astro';
import PcbTrace from './PcbTrace.astro';
import SearchCTA from './SearchCTA.astro';
import { agent } from '../data/site';
import { withBase } from '../lib/paths';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--dot">San Diego · Palm Springs · Big Bear</p>
      <h1 id="hero-title">
        Three California Markets.<br />
        <em>One Agent.</em>
      </h1>
      <p class="lede">
        Coastal, desert and mountain real estate with one point of contact. I don't just work in these
        markets. I've owned and managed homes, cabins and investment properties in all three since 2018.
      </p>
      <div class="hero__actions">
        <SearchCTA />
        <a class="btn btn--ghost" href={withBase('/contact')}>Start a conversation</a>
      </div>
      <ul class="hero__contact" aria-label="Contact David">
        <li>
          <Icon name="phone" size={15} />
          <a href={agent.phoneHref}>{agent.phone}</a>
        </li>
        <li>
          <Icon name="mail" size={15} />
          <a href={`mailto:${agent.email}`}>{agent.email}</a>
        </li>
        <li>
          <Icon name="mail" size={15} />
          <a href={`mailto:${agent.emailCompass}`}>{agent.emailCompass}</a>
        </li>
      </ul>
    </div>

    <figure class="hero__portrait">
      <PcbTrace variant="portrait" class="hero__trace" />
      <div class="hero__frame">
        <img
          src={withBase(agent.headshot.src)}
          alt={agent.headshot.alt}
          width={agent.headshot.width}
          height={agent.headshot.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="hero__caption">
        <span class="hero__caption-name">{agent.name}</span>
        <span class="hero__caption-title">{agent.title}</span>
        <span class="hero__caption-meta">{agent.brokerage} · CA DRE #{agent.dre}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .hero__copy h1 {
    font-size: clamp(2.75rem, 5.8vw, 4.75rem);
    line-height: 1.02;
    max-width: 14ch;
  }
  .hero__copy h1 em {
    font-weight: 500;
    color: var(--ink-2);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .hero__contact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--ink-2);
  }
  .hero__contact li {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }
  .hero__contact svg {
    color: var(--muted);
  }
  .hero__contact a {
    text-decoration: none;
  }
  .hero__contact a:hover {
    text-decoration: underline;
  }

  .hero__portrait {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }
  .hero__trace {
    position: absolute;
    inset: -12% -18%;
    width: auto;
    height: auto;
    z-index: 0;
  }
  .hero__frame {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-2);
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px rgba(22, 24, 27, 0.35);
  }
  .hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .hero__caption {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.2rem;
    margin: -2.4rem 0 0 -1.25rem;
    width: max-content;
    max-width: calc(100% + 1.25rem);
    padding: 0.95rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-card);
    line-height: 1.35;
  }
  .hero__caption-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
  }
  .hero__caption-title {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .hero__caption-meta {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__portrait {
      order: -1;
      width: min(100%, 320px);
      justify-self: start;
    }
    .hero__caption {
      margin-left: 0;
    }
  }
  @media (max-width: 540px) {
    .hero__actions {
      width: 100%;
      flex-direction: column;
    }
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
