---
/**
 * ContactForm — fields per the copy deck: Name, Email, Phone, Interested In,
 * Location, Message. If PUBLIC_FORM_ENDPOINT is set at build time (a
 * Formspree or Basin URL) the form posts there as JSON. Without it,
 * submitting opens the visitor's email app with the message pre-filled, so
 * the form is never a dead end. Includes a honeypot field for spam.
 */
import Icon from './Icon.astro';
import { agent } from '../data/site';
import { contact } from '../data/contact';
import { withBase } from '../lib/paths';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const f = contact.form;
---

<form class="cf" method="post" action={endpoint || undefined} data-endpoint={endpoint} data-email={agent.email} novalidate>
  <div class="cf__row">
    <label class="cf__field">
      <span>Name</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label class="cf__field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
  </div>
  <div class="cf__row">
    <label class="cf__field">
      <span>Phone</span>
      <input type="tel" name="phone" autocomplete="tel" />
    </label>
    <label class="cf__field">
      <span>Interested in</span>
      <select name="interest">
        {f.interestedIn.map((v) => <option value={v}>{v}</option>)}
      </select>
    </label>
  </div>
  <label class="cf__field">
    <span>Location</span>
    <select name="location">
      {f.locations.map((v) => <option value={v}>{v}</option>)}
    </select>
  </label>
  <label class="cf__field">
    <span>Message</span>
    <textarea name="message" rows="6" required></textarea>
  </label>
  <div class="cf__hp" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="cf__foot">
    <button class="btn" type="submit">
      <span>{f.submit}</span>
      <Icon name="arrow-right" />
    </button>
    <p class="cf__note">Your details go only to David. See the <a href={withBase('/privacy-policy')}>Privacy Policy</a>.</p>
  </div>
  <p class="cf__status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('.cf');
  if (form) {
    const status = form.querySelector<HTMLElement>('.cf__status')!;
    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.dataset.state = '';
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      if ((data.get('_gotcha') as string)?.length) return; // bot
      const fields = Object.fromEntries(data.entries()) as Record<string, string>;
      const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;

      if (endpoint) {
        button.disabled = true;
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(fields),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          status.dataset.state = 'ok';
          status.textContent = 'Thanks. Your message is on its way.';
        } catch {
          status.dataset.state = 'error';
          status.textContent = `Something went wrong sending that. Email me directly at ${email}.`;
        } finally {
          button.disabled = false;
        }
        return;
      }

      // No endpoint configured: hand off to the visitor's email app.
      const subject = `Website inquiry: ${fields.interest || 'General'}${fields.location ? ` · ${fields.location}` : ''}`;
      const body = [
        `Name: ${fields.name}`,
        `Email: ${fields.email}`,
        fields.phone ? `Phone: ${fields.phone}` : '',
        `Interested in: ${fields.interest}`,
        `Location: ${fields.location}`,
        '',
        fields.message,
      ]
        .filter((l) => l !== '')
        .join('\n');
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.dataset.state = 'ok';
      status.textContent = `Your email app should open with the message ready to send. If it doesn't, email ${email}.`;
    });
  }
</script>

<style>
  .cf {
    display: grid;
    gap: 1.1rem;
  }
  .cf__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .cf__field {
    display: grid;
    gap: 0.4rem;
  }
  .cf__field > span {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .cf input,
  .cf select,
  .cf textarea {
    width: 100%;
    padding: 0.85rem 0.95rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-control);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .cf textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .cf input:focus-visible,
  .cf select:focus-visible,
  .cf textarea:focus-visible {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.14);
  }
  .cf__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.25rem;
  }
  .cf__note {
    font-size: 0.8125rem;
    color: var(--muted);
    max-width: 32ch;
    line-height: 1.5;
  }
  .cf__note a {
    color: var(--ink-2);
  }
  .cf__status:empty {
    display: none;
  }
  .cf__status {
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1.5;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .cf__status[data-state='error'] {
    border-color: var(--blue);
  }
  @media (max-width: 560px) {
    .cf__row {
      grid-template-columns: 1fr;
    }
  }
</style>
