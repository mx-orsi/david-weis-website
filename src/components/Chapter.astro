---
/**
 * Chapter — an editorial deep-dive inside a project page, rendered from a
 * list of typed blocks in src/data/projects.ts (story, photo, pair, callout,
 * compare, gallery). ProjectPage.astro inserts it after the story section
 * the data names, so the surrounding page structure stays shared.
 *
 * Rhythm rules: photographs get whitespace, full-bleed images are used
 * sparingly, headings stay sentence case in markup, and nothing moves unless
 * the visitor moves it.
 */
import Compare from './Compare.astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import Media from './Media.astro';
import Sequence from './Sequence.astro';
import Story from './Story.astro';
import type { ProjectChapter } from '../data/projects';
import { withBase } from '../lib/paths';
import { photoExists } from '../lib/images';

interface Props {
  chapter: ProjectChapter;
  /** Used to build unique heading ids. */
  slug: string;
}
const { chapter, slug } = Astro.props;

---

<section class="ch" id={chapter.id} aria-label={chapter.id.replace(/-/g, " ")}>
  {chapter.blocks.map((b, i) => {
    const hid = `${slug}-${chapter.id}-${i}`;
    if (b.type === 'story') {
      const asideRatio = b.asideRatio ?? '4 / 5';
      const level = b.level ?? (b.sub ? 3 : 2);
      return b.aside ? (
        <div class="container ch__block ch__aside">
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} level={level} id={hid} />
          <figure class="ch__aside-figure">
            <Media photo={b.aside} ratio={asideRatio} sizes="(min-width: 960px) 40vw, 100vw" class="ch__aside-photo" />
            {b.asideCaption && <figcaption class="ch__caption">{b.asideCaption}</figcaption>}
          </figure>
        </div>
      ) : (
        <div class:list={['container', 'ch__block', b.sub && 'ch__sub']}>
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} layout="split" level={level} id={hid} />
        </div>
      );
    }
    if (b.type === 'photo') {
      const zoomable = photoExists(b.photo.src);
      const media = <Media photo={b.photo} ratio={b.ratio ?? '16 / 9'} sizes="100vw" />;
      const inner = (
        <figure class="ch__figure">
          {zoomable ? (
            <a class="ch__zoom" href={withBase(b.photo.src!)} data-lightbox data-caption={b.caption ?? b.photo.alt ?? ''}>
              {media}
            </a>
          ) : (
            media
          )}
          {b.caption && <figcaption class="ch__caption">{b.caption}</figcaption>}
          {b.link && (
            b.link.external ? (
              <a class="link-arrow link-arrow--ext" href={b.link.href} target="_blank" rel="noopener noreferrer">
                {b.link.label} <Icon name="arrow-ext" /><span class="sr-only"> (opens in a new tab)</span>
              </a>
            ) : (
              <a class="link-arrow" href={withBase(b.link.href)}>{b.link.label} <Icon name="arrow-right" /></a>
            )
          )}
        </figure>
      );
      return b.width === 'bleed' ? <div class="ch__block ch__bleed">{inner}</div> : <div class="container ch__block">{inner}</div>;
    }
    if (b.type === 'pair') {
      return (
        <div class="container ch__block">
          <div class:list={['ch__pair', b.emphasis && `ch__pair--emphasis-${b.emphasis}`, b.align && `ch__pair--${b.align}`]}>
            {b.photos.map((ph, j) => {
              const zoomable = photoExists(ph.src);
              const cap = b.captions?.[j];
              const lightboxCaption = (typeof cap === 'string' ? cap : cap?.title) ?? b.caption?.title ?? ph.alt ?? '';
              const media = <Media photo={ph} ratio={b.ratio ?? '4 / 3'} sizes={b.align ? '(min-width: 900px) 36vw, 100vw' : undefined} />;
              return (
                <figure class="ch__figure">
                  <div class="ch__pair-media">
                    {zoomable ? (
                      <a class="ch__zoom" href={withBase(ph.src!)} data-lightbox data-caption={lightboxCaption}>
                        {media}
                      </a>
                    ) : (
                      media
                    )}
                    {b.labels?.[j] && <span class="ch__pair-tag">{b.labels[j]}</span>}
                  </div>
                  {typeof cap === 'string' && <figcaption class="ch__caption">{cap}</figcaption>}
                  {cap && typeof cap !== 'string' && (
                    <figcaption class="ch__caption">
                      <span class="ch__cap-title">{cap.title}</span>
                      {cap.note && <span class="ch__cap-note">{cap.note}</span>}
                    </figcaption>
                  )}
                </figure>
              );
            })}
            {b.caption && (
              <p class="ch__caption ch__pair-caption">
                <span class="ch__cap-title">{b.caption.title}</span>
                {b.caption.note && <span class="ch__cap-note">{b.caption.note}</span>}
              </p>
            )}
          </div>
        </div>
      );
    }
    if (b.type === 'callout') {
      return (
        <div class:list={['container', 'ch__block', 'ch__callout', b.second && 'ch__callout--two']}>
          <p class="ch__pull">{b.text}</p>
          {b.second && <p class="ch__pull ch__pull--second">{b.second}</p>}
          {b.note && <p class="ch__note">{b.note}</p>}
          {b.paragraphs && (
            <div class="prose ch__pull-prose">
              {b.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          )}
        </div>
      );
    }
    if (b.type === 'compare') {
      return (
        <div class="container ch__block ch__compare" aria-labelledby={hid}>
          <div class="split">
            <h2 id={hid} class="title-lg ch__compare-title">{b.heading}</h2>
            <div class="prose">
              {b.paragraphs.map((p) => <p>{p}</p>)}
              <p class="ch__hint">Drag the divider to compare.</p>
            </div>
          </div>
          <div class="ch__compare-grid">
            {b.pairs.map((pair, j) => <Compare pair={pair} ratio="3 / 2" class={j === 0 ? 'ch__compare-lead' : undefined} sizes={j === 0 ? '100vw' : '(min-width: 1024px) 50vw, 100vw'} />)}
          </div>
        </div>
      );
    }
    if (b.type === 'gallery') {
      return (
        <div class="container ch__block">
          <Gallery photos={b.photos} captions={b.captions} label={b.label} />
        </div>
      );
    }
    if (b.type === 'strip') {
      const cols = b.bleed ? b.photos.length : 7;
      return (
        <div class:list={['ch__block', 'ch__strip', b.bleed ? 'ch__strip--bleed' : 'container']}>
          {b.heading && <h2 id={hid} class="title-md ch__strip-title">{b.heading}</h2>}
          <ul class="ch__strip-list" data-strip style={`--strip-cols: ${cols}`}>
            {b.photos.map((ph, j) => (
              <li class="ch__strip-item">
                <button type="button" class="ch__strip-btn" aria-pressed="false" aria-label={`Reveal: ${b.labels[j]}`}>
                  <Media photo={ph} ratio="4 / 5" sizes={`(min-width: 1024px) ${Math.round(100 / cols)}vw, 33vw`} />
                  <span class="ch__strip-label" aria-hidden="true">{b.labels[j]}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="ch__strip-hint">Hover or tap a photo to see which one it is.</p>
          {b.closing && <p class="ch__strip-closing">{b.closing}</p>}
        </div>
      );
    }
    if (b.type === 'cta') {
      return (
        <div class="container ch__block ch__cta">
          <a
            class="link-arrow link-arrow--ext"
            href={b.external ? b.href : withBase(b.href)}
            target={b.external ? '_blank' : undefined}
            rel={b.external ? 'noopener noreferrer' : undefined}
          >
            {b.label} <Icon name="arrow-ext" />
            {b.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
          {b.note && <p class="ch__cta-note">{b.note}</p>}
        </div>
      );
    }
    if (b.type === 'sequence') {
      return (
        <div class="container ch__block">
          <Sequence heading={b.heading} intro={b.intro} stages={b.stages} />
        </div>
      );
    }
    return null;
  })}
</section>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ch__strip-btn');
      if (!btn) return;
      const open = btn.getAttribute('aria-pressed') === 'true';
      for (const b of list.querySelectorAll('.ch__strip-btn')) b.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-pressed', open ? 'false' : 'true');
    });
  }
</script>

<style>
  .ch {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
  }
  .ch__block {
    min-width: 0;
  }

  .ch__aside {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .ch__aside-figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }

  .ch__figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .ch__bleed {
    width: 100%;
  }
  .ch__bleed .ch__figure :global(.media),
  .ch__bleed .ch__figure :global(.slot) {
    max-height: 88vh;
  }
  .ch__bleed .ch__caption {
    padding-inline: var(--gutter);
  }
  .ch__caption {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  /* Titled captions: a small uppercase title with a muted note under it (matches Gallery). */
  .ch__cap-title {
    display: block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ch__cap-note {
    display: block;
    margin-top: 0.2rem;
  }

  /* A sub-section: sits tighter under the block before it, behind a thin rule. */
  .ch__sub {
    margin-top: calc(-1 * clamp(1.75rem, 4vw, 3.75rem));
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line-strong);
  }

  .ch__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .ch__pair--emphasis-first {
    grid-template-columns: 3fr 2fr;
  }
  .ch__pair--emphasis-second {
    grid-template-columns: 2fr 3fr;
  }
  .ch__pair--left,
  .ch__pair--right {
    max-width: 72%;
  }
  .ch__pair--right {
    margin-left: auto;
  }
  .ch__pair-caption {
    grid-column: 1 / -1;
    margin-top: 0.25rem;
  }
  .ch__pair-media {
    position: relative;
  }
  .ch__pair-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35em 0.7em;
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.88);
    pointer-events: none;
  }

  .ch__cta {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .ch__cta-note {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .ch__callout {
    display: grid;
    gap: 1.75rem;
    padding-block: 0.5rem;
  }
  .ch__pull {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 30ch;
    color: var(--ink);
    text-wrap: balance;
  }
  .ch__pull-prose {
    padding-left: 1.25rem;
    border-left: 2px solid var(--blue);
  }
  .ch__callout--two {
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }
  .ch__pull--second {
    color: var(--blue);
  }
  .ch__note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    color: var(--ink-2);
    margin-top: -0.75rem;
  }

  /* Strip: hover or tap reveals the unit number. */
  .ch__strip {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .ch__strip-title {
    max-width: 20ch;
  }
  .ch__strip-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--strip-cols, 7), minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
  }
  .ch__strip--bleed {
    width: 100%;
    padding-inline: var(--gutter);
  }
  .ch__strip--bleed .ch__strip-list {
    gap: 1rem;
  }
  .ch__strip-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .ch__strip-btn:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .ch__strip-label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.55em 0.7em;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-ink);
    background: rgba(10, 11, 13, 0.82);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .ch__strip-btn:focus-visible .ch__strip-label,
  .ch__strip-btn[aria-pressed='true'] .ch__strip-label {
    opacity: 1;
  }
  @media (hover: hover) {
    .ch__strip-btn:hover .ch__strip-label {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch__strip-label {
      transition: none;
    }
  }
  .ch__strip-hint {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ch__strip-closing {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.4;
    max-width: 34ch;
    color: var(--ink);
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    margin-top: 0.5rem;
  }

  .ch__compare {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .ch__compare-title {
    max-width: 14ch;
  }
  .ch__hint {
    font-size: 0.8125rem !important;
    color: var(--muted) !important;
  }
  .ch__compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ch__compare-grid :global(.ch__compare-lead) {
    grid-column: 1 / -1;
  }


  /* Editorial gallery: a six-column grid with items of three sizes. */
  .ch__gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.25rem;
    align-items: start;
  }
  .ch__gallery :global(.ch__g--tall),
  .ch__gallery :global(.ch__g--small) {
    grid-column: span 2;
  }
  .ch__gallery :global(.ch__g--wide) {
    grid-column: span 4;
  }

  @media (max-width: 899px) {
    .ch__strip-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ch__aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .ch__aside-figure {
      justify-self: start;
    }
    .ch__pair--left,
    .ch__pair--right {
      max-width: none;
    }
    .ch__compare-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 599px) {
    .ch__pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .ch__strip-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .ch__strip-label {
      font-size: 0.5625rem;
      padding: 0.45em 0.5em;
    }
  }
</style>
