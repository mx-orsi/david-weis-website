---
/**
 * Chapter — an editorial deep-dive inside a project page, rendered from a
 * list of typed blocks in src/data/projects.ts (story, photo, pair, callout,
 * compare, gallery). ProjectPage.astro inserts it after the story section
 * the data names, so the surrounding page structure stays shared.
 *
 * Rhythm rules: photographs get whitespace, full-bleed images are used
 * sparingly, headings stay sentence case in markup, and nothing moves unless
 * the visitor moves it.
 */
import Compare from './Compare.astro';
import Media from './Media.astro';
import Story from './Story.astro';
import type { ProjectChapter } from '../data/projects';

interface Props {
  chapter: ProjectChapter;
  /** Used to build unique heading ids. */
  slug: string;
}
const { chapter, slug } = Astro.props;

/** Size pattern for the editorial gallery, cycling by position. */
const galleryShape = ['wide', 'small', 'small', 'tall', 'small', 'tall', 'wide'] as const;
const galleryRatio: Record<(typeof galleryShape)[number], string> = { tall: '4 / 5', wide: '4 / 3', small: '1 / 1' };
---

<section class="ch" id={chapter.id} aria-label="Chapter">
  {chapter.blocks.map((b, i) => {
    const hid = `${slug}-${chapter.id}-${i}`;
    if (b.type === 'story') {
      return b.aside ? (
        <div class="container ch__block ch__aside">
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} id={hid} />
          <Media photo={b.aside} ratio="4 / 5" sizes="(min-width: 960px) 40vw, 100vw" class="ch__aside-photo" />
        </div>
      ) : (
        <div class="container ch__block">
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} layout="split" id={hid} />
        </div>
      );
    }
    if (b.type === 'photo') {
      const inner = (
        <figure class="ch__figure">
          <Media photo={b.photo} ratio={b.ratio ?? '16 / 9'} sizes="100vw" />
          {b.caption && <figcaption class="ch__caption">{b.caption}</figcaption>}
        </figure>
      );
      return b.width === 'bleed' ? <div class="ch__block ch__bleed">{inner}</div> : <div class="container ch__block">{inner}</div>;
    }
    if (b.type === 'pair') {
      return (
        <div class="container ch__block ch__pair">
          {b.photos.map((ph, j) => (
            <figure class="ch__figure">
              <Media photo={ph} ratio={b.ratio ?? '4 / 3'} />
              {b.captions?.[j] && <figcaption class="ch__caption">{b.captions[j]}</figcaption>}
            </figure>
          ))}
        </div>
      );
    }
    if (b.type === 'callout') {
      return (
        <div class:list={['container', 'ch__block', 'ch__callout', b.second && 'ch__callout--two']}>
          <p class="ch__pull">{b.text}</p>
          {b.second && <p class="ch__pull ch__pull--second">{b.second}</p>}
          {b.note && <p class="ch__note">{b.note}</p>}
          {b.paragraphs && (
            <div class="prose ch__pull-prose">
              {b.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          )}
        </div>
      );
    }
    if (b.type === 'compare') {
      return (
        <div class="container ch__block ch__compare" aria-labelledby={hid}>
          <div class="split">
            <h2 id={hid} class="title-lg ch__compare-title">{b.heading}</h2>
            <div class="prose">
              {b.paragraphs.map((p) => <p>{p}</p>)}
              <p class="ch__hint">Drag the divider to compare.</p>
            </div>
          </div>
          <div class="ch__compare-grid">
            {b.pairs.map((pair, j) => <Compare pair={pair} ratio="3 / 2" class={j === 0 ? 'ch__compare-lead' : undefined} sizes={j === 0 ? '100vw' : '(min-width: 1024px) 50vw, 100vw'} />)}
          </div>
        </div>
      );
    }
    if (b.type === 'gallery') {
      return (
        <div class="container ch__block ch__gallery" role="group" aria-label={b.label}>
          {b.photos.map((ph, j) => {
            const shape = galleryShape[j % galleryShape.length];
            const cap = b.captions?.[j];
            return cap ? (
              <figure class={`ch__figure ch__g ch__g--${shape}`}>
                <Media photo={ph} ratio={galleryRatio[shape]} sizes="(min-width: 1024px) 33vw, 50vw" />
                <figcaption class="ch__caption ch__caption--unit">
                  <span class="ch__unit">{cap.title}</span>
                  {cap.note && <span class="ch__unit-note">{cap.note}</span>}
                </figcaption>
              </figure>
            ) : (
              <Media photo={ph} ratio={galleryRatio[shape]} class={`ch__g ch__g--${shape}`} sizes="(min-width: 1024px) 33vw, 50vw" />
            );
          })}
        </div>
      );
    }
    if (b.type === 'strip') {
      return (
        <div class="container ch__block ch__strip">
          <h2 id={hid} class="title-md ch__strip-title">{b.heading}</h2>
          <ul class="ch__strip-list" data-strip>
            {b.photos.map((ph, j) => (
              <li class="ch__strip-item">
                <button type="button" class="ch__strip-btn" aria-pressed="false" aria-label={`Reveal: ${b.labels[j]}`}>
                  <Media photo={ph} ratio="4 / 5" sizes="(min-width: 1024px) 14vw, 33vw" />
                  <span class="ch__strip-label" aria-hidden="true">{b.labels[j]}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="ch__strip-hint">Hover or tap a residence to see which one it is.</p>
          {b.closing && <p class="ch__strip-closing">{b.closing}</p>}
        </div>
      );
    }
    return null;
  })}
</section>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ch__strip-btn');
      if (!btn) return;
      const open = btn.getAttribute('aria-pressed') === 'true';
      for (const b of list.querySelectorAll('.ch__strip-btn')) b.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-pressed', open ? 'false' : 'true');
    });
  }
</script>

<style>
  .ch {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
  }
  .ch__block {
    min-width: 0;
  }

  .ch__aside {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .ch :global(.ch__aside-photo) {
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }

  .ch__figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .ch__bleed {
    width: 100%;
  }
  .ch__bleed .ch__figure :global(.media),
  .ch__bleed .ch__figure :global(.slot) {
    max-height: 88vh;
  }
  .ch__bleed .ch__caption {
    padding-inline: var(--gutter);
  }
  .ch__caption {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .ch__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .ch__callout {
    display: grid;
    gap: 1.75rem;
    padding-block: 0.5rem;
  }
  .ch__pull {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.6vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 30ch;
    color: var(--ink);
    text-wrap: balance;
  }
  .ch__pull-prose {
    padding-left: 1.25rem;
    border-left: 2px solid var(--blue);
  }
  .ch__callout--two {
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }
  .ch__pull--second {
    color: var(--blue);
  }
  .ch__note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    color: var(--ink-2);
    margin-top: -0.75rem;
  }
  .ch__caption--unit {
    display: grid;
    gap: 0.15rem;
  }
  .ch__unit {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ch__unit-note {
    color: var(--muted);
  }

  /* Strip: hover or tap reveals the unit number. */
  .ch__strip {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .ch__strip-title {
    max-width: 20ch;
  }
  .ch__strip-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
    width: 100%;
  }
  .ch__strip-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  .ch__strip-btn:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .ch__strip-label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.55em 0.7em;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-ink);
    background: rgba(10, 11, 13, 0.82);
    opacity: 0;
    transition: opacity 0.2s var(--ease);
  }
  .ch__strip-btn:focus-visible .ch__strip-label,
  .ch__strip-btn[aria-pressed='true'] .ch__strip-label {
    opacity: 1;
  }
  @media (hover: hover) {
    .ch__strip-btn:hover .ch__strip-label {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch__strip-label {
      transition: none;
    }
  }
  .ch__strip-hint {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .ch__strip-closing {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.4;
    max-width: 34ch;
    color: var(--ink);
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
    margin-top: 0.5rem;
  }

  .ch__compare {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .ch__compare-title {
    max-width: 14ch;
  }
  .ch__hint {
    font-size: 0.8125rem !important;
    color: var(--muted) !important;
  }
  .ch__compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ch__compare-grid :global(.ch__compare-lead) {
    grid-column: 1 / -1;
  }

  /* Editorial gallery: a six-column grid with items of three sizes. */
  .ch__gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 1.25rem;
    align-items: start;
  }
  .ch__gallery :global(.ch__g--tall),
  .ch__gallery :global(.ch__g--small) {
    grid-column: span 2;
  }
  .ch__gallery :global(.ch__g--wide) {
    grid-column: span 4;
  }

  @media (max-width: 899px) {
    .ch__strip-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .ch__aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .ch :global(.ch__aside-photo) {
      justify-self: start;
    }
    .ch__compare-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ch__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }
    .ch__gallery :global(.ch__g--tall),
    .ch__gallery :global(.ch__g--small) {
      grid-column: span 1;
    }
    .ch__gallery :global(.ch__g--wide) {
      grid-column: span 2;
    }
  }
  @media (max-width: 599px) {
    .ch__pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .ch__strip-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .ch__strip-label {
      font-size: 0.5625rem;
      padding: 0.45em 0.5em;
    }
  }
</style>
