---
/**
 * Chapter — an editorial deep-dive inside a project page, rendered from a
 * list of typed blocks in src/data/projects.ts (story, photo, pair, callout,
 * compare, gallery). ProjectPage.astro inserts it after the story section
 * the data names, so the surrounding page structure stays shared.
 *
 * Rhythm rules: photographs get whitespace, full-bleed images are used
 * sparingly, headings stay sentence case in markup, and nothing moves unless
 * the visitor moves it.
 */
import Compare from './Compare.astro';
import Gallery from './Gallery.astro';
import Icon from './Icon.astro';
import Media from './Media.astro';
import Sequence from './Sequence.astro';
import Story from './Story.astro';
import type { ProjectChapter } from '../data/projects';
import { withBase } from '../lib/paths';
import { photoExists } from '../lib/images';
import { hasInline, renderInline } from '../lib/inline';

interface Props {
  chapter: ProjectChapter;
  /** Used to build unique heading ids. */
  slug: string;
}
const { chapter, slug } = Astro.props;

---

<section class="ch" id={chapter.id} aria-label={chapter.id.replace(/-/g, " ")}>
  {chapter.blocks.map((b, i) => {
    const hid = `${slug}-${chapter.id}-${i}`;
    if (b.type === 'story') {
      const asideRatio = b.asideRatio ?? '4 / 5';
      const band = (b as { band?: boolean }).band === true;
      const level = b.level ?? (b.sub && !band ? 3 : 2);
      if (band) {
        return (
          <div class="ch__band">
            <div class="container ch__band-inner">
              <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} layout="split" level={level} id={hid} class="ch__band-story" />
            </div>
          </div>
        );
      }
      return b.aside ? (
        <div class:list={['container', 'ch__block', 'ch__aside', b.asideAlign === 'center' && 'ch__aside--center']}>
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} level={level} id={hid} />
          <figure class="ch__aside-figure">
            <Media photo={b.aside} ratio={asideRatio} sizes="(min-width: 960px) 40vw, 100vw" class="ch__aside-photo" />
            {b.asideCaption && <figcaption class="ch__caption">{b.asideCaption}</figcaption>}
            {b.asideMore && <Media photo={b.asideMore} ratio={asideRatio} sizes="(min-width: 960px) 40vw, 100vw" class="ch__aside-photo ch__aside-more" />}
            {b.asideMoreCaption && <p class="ch__caption">{b.asideMoreCaption}</p>}
          </figure>
        </div>
      ) : (
        <div class:list={['container', 'ch__block', b.sub && 'ch__sub']}>
          <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} layout="split" level={level} id={hid} />
        </div>
      );
    }
    if (b.type === 'photo') {
      const zoomable = photoExists(b.photo.src);
      const cap = b.caption;
      const lightboxCaption = (typeof cap === 'string' ? cap : cap?.title) ?? b.photo.alt ?? '';
      const media = <Media photo={b.photo} ratio={b.ratio ?? '16 / 9'} sizes="100vw" />;
      const inner = (
        <figure class="ch__figure">
          {zoomable ? (
            <a class="ch__zoom" href={withBase(b.photo.src!)} data-lightbox data-caption={lightboxCaption}>
              {media}
            </a>
          ) : (
            media
          )}
          {typeof cap === 'string' && <figcaption class="ch__caption">{cap}</figcaption>}
          {cap && typeof cap !== 'string' && (
            <figcaption class="ch__caption">
              <span class="ch__cap-title">{cap.title}</span>
              {cap.note && <span class="ch__cap-note">{cap.note}</span>}
            </figcaption>
          )}
          {b.link && (
            b.link.external ? (
              <a class="link-arrow link-arrow--ext" href={b.link.href} target="_blank" rel="noopener noreferrer">
                {b.link.label} <Icon name="arrow-ext" /><span class="sr-only"> (opens in a new tab)</span>
              </a>
            ) : (
              <a class="link-arrow" href={withBase(b.link.href)}>{b.link.label} <Icon name="arrow-right" /></a>
            )
          )}
        </figure>
      );
      return b.width === 'bleed' ? <div class="ch__block ch__bleed">{inner}</div> : <div class="container ch__block">{inner}</div>;
    }
    if (b.type === 'pair') {
      return (
        <div class="container ch__block">
          <div class:list={['ch__pair', b.emphasis && `ch__pair--emphasis-${b.emphasis}`, b.align && `ch__pair--${b.align}`]}>
            {b.photos.map((ph, j) => {
              const zoomable = photoExists(ph.src);
              const cap = b.captions?.[j];
              const lightboxCaption = (typeof cap === 'string' ? cap : cap?.title) ?? b.caption?.title ?? ph.alt ?? '';
              const media = <Media photo={ph} ratio={b.ratio ?? '4 / 3'} sizes={b.align ? '(min-width: 900px) 36vw, 100vw' : undefined} />;
              return (
                <figure class="ch__figure">
                  <div class="ch__pair-media">
                    {zoomable ? (
                      <a class="ch__zoom" href={withBase(ph.src!)} data-lightbox data-caption={lightboxCaption}>
                        {media}
                      </a>
                    ) : (
                      media
                    )}
                    {b.labels?.[j] && <span class="ch__pair-tag">{b.labels[j]}</span>}
                  </div>
                  {typeof cap === 'string' && <figcaption class="ch__caption">{cap}</figcaption>}
                  {cap && typeof cap !== 'string' && (
                    <figcaption class="ch__caption">
                      <span class="ch__cap-title">{cap.title}</span>
                      {cap.note && <span class="ch__cap-note">{cap.note}</span>}
                    </figcaption>
                  )}
                </figure>
              );
            })}
            {b.caption && (
              <p class="ch__caption ch__pair-caption">
                <span class="ch__cap-title">{b.caption.title}</span>
                {b.caption.note && <span class="ch__cap-note">{b.caption.note}</span>}
              </p>
            )}
          </div>
        </div>
      );
    }
    if (b.type === 'collage') {
      const fill = b.fill ?? (b.columns[0].length > b.columns[1].length ? 'second' : 'first');
      return (
        <div class="container ch__block">
          <div class:list={['ch__collage', b.emphasis && `ch__collage--emphasis-${b.emphasis}`]}>
            {b.columns.map((col, ci) => {
              const isFill = (ci === 0 ? 'first' : 'second') === fill;
              const cap = b.captions?.[ci];
              return (
                <div class:list={['ch__collage-col', isFill && 'ch__collage-col--fill']}>
                  <div class="ch__collage-stack">
                    {col.map((ph, pi) => {
                      const zoomable = photoExists(ph.src);
                      const media = <Media photo={ph} ratio={isFill ? 'auto' : (b.ratio ?? '4 / 3')} sizes="(min-width: 900px) 50vw, 100vw" />;
                      const tag = pi === 0 && b.labels?.[ci];
                      return zoomable ? (
                        <a class="ch__zoom ch__collage-item" href={withBase(ph.src!)} data-lightbox data-caption={ph.alt ?? ''}>
                          {media}
                          {tag && <span class="ch__pair-tag">{tag}</span>}
                        </a>
                      ) : (
                        <div class="ch__collage-item">{media}{tag && <span class="ch__pair-tag">{tag}</span>}</div>
                      );
                    })}
                  </div>
                  {typeof cap === 'string' && <p class="ch__caption">{cap}</p>}
                  {cap && typeof cap !== 'string' && (
                    <p class="ch__caption">
                      <span class="ch__cap-title">{cap.title}</span>
                      {cap.note && <span class="ch__cap-note">{cap.note}</span>}
                    </p>
                  )}
                </div>
              );
            })}
            {b.caption && (
              <p class="ch__caption ch__pair-caption">
                <span class="ch__cap-title">{b.caption.title}</span>
                {b.caption.note && <span class="ch__cap-note">{b.caption.note}</span>}
              </p>
            )}
          </div>
        </div>
      );
    }
    if (b.type === 'callout') {
      return (
        <div class:list={['container', 'ch__block', 'ch__callout', b.second && 'ch__callout--two']}>
          <p class="ch__pull">{b.text}</p>
          {b.second && <p class="ch__pull ch__pull--second">{b.second}</p>}
          {b.note && <p class="ch__note">{b.note}</p>}
          {b.paragraphs && (
            <div class="prose ch__pull-prose">
              {b.paragraphs.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
            </div>
          )}
        </div>
      );
    }
    if (b.type === 'compare') {
      return (
        <div class="container ch__block ch__compare" aria-labelledby={hid}>
          <div class="split">
            <h2 id={hid} class="title-lg ch__compare-title">{b.heading}</h2>
            <div class="prose">
              {b.paragraphs.map((p) => <p>{p}</p>)}
              <p class="ch__hint">Drag the divider to compare.</p>
            </div>
          </div>
          <div class="ch__compare-grid">
            {b.pairs.map((pair, j) => <Compare pair={pair} ratio="3 / 2" class={j === 0 ? 'ch__compare-lead' : undefined} sizes={j === 0 ? '100vw' : '(min-width: 1024px) 50vw, 100vw'} />)}
          </div>
        </div>
      );
    }
    if (b.type === 'gallery') {
      return (
        <div class="container ch__block">
          <Gallery photos={b.photos} captions={b.captions} label={b.label} caption={b.caption} spacing={b.spacing} />
        </div>
      );
    }
    if (b.type === 'tiles') {
      return (
        <div class="container ch__block">
          <ul class="ch__tiles" style={`--tile-cols: ${b.items.length}`}>
            {b.items.map((t, j) => (
              <li class="ch__tile">
                <a class="ch__tile-media" href={withBase(t.cta.href)} tabindex="-1" aria-hidden="true">
                  <Media photo={t.photo} ratio="1 / 1" sizes="(min-width: 900px) 45vw, 100vw" />
                </a>
                <div class="ch__tile-copy">
                  <p class="eyebrow">{t.eyebrow}</p>
                  <h3 class="title-md ch__tile-title" id={`${hid}-${j}`}>{t.heading}</h3>
                  <div class="prose">
                    {t.paragraphs.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
                  </div>
                  <a class="link-arrow" href={withBase(t.cta.href)}>{t.cta.label} <Icon name="arrow-right" /></a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      );
    }
    if (b.type === 'strip') {
      const cols = b.bleed ? b.photos.length : 7;
      return (
        <div class:list={['ch__block', 'ch__strip', b.bleed ? 'ch__strip--bleed' : 'container']}>
          {b.heading && <h2 id={hid} class="title-md ch__strip-title">{b.heading}</h2>}
          <ul class="ch__strip-list" data-strip style={`--strip-cols: ${cols}`}>
            {b.photos.map((ph, j) => (
              <li class="ch__strip-item">
                <button type="button" class="ch__strip-btn" aria-pressed="false" aria-label={`Reveal: ${b.labels[j]}`}>
                  <Media photo={ph} ratio="4 / 5" sizes={`(min-width: 1024px) ${Math.round(100 / cols)}vw, 33vw`} />
                  <span class="ch__strip-label" aria-hidden="true">{b.labels[j]}</span>
                </button>
              </li>
            ))}
          </ul>
          <p class="ch__strip-hint">Hover or tap a photo to see which one it is.</p>
          {b.closing && <p class="ch__strip-closing">{b.closing}</p>}
        </div>
      );
    }
    if (b.type === 'cta') {
      return (
        <div class="container ch__block ch__cta">
          <a
            class="link-arrow link-arrow--ext"
            href={b.external ? b.href : withBase(b.href)}
            target={b.external ? '_blank' : undefined}
            rel={b.external ? 'noopener noreferrer' : undefined}
          >
            {b.label} <Icon name="arrow-ext" />
            {b.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
          {b.note && <p class="ch__cta-note">{b.note}</p>}
        </div>
      );
    }
    if (b.type === 'teaser') {
      return (
        <div class:list={['container', 'ch__block', 'ch__teaser', b.side === 'left' && 'ch__teaser--left']}>
          <div class="ch__teaser-copy">
            <Story heading={b.heading} paragraphs={b.paragraphs} eyebrow={b.eyebrow} level={2} id={hid}>
              <p class="ch__teaser-cta">
                <a class="link-arrow" href={withBase(b.cta.href)}>{b.cta.label} <Icon name="arrow-right" /></a>
              </p>
            </Story>
          </div>
          <a class="ch__teaser-media" href={withBase(b.cta.href)} tabindex="-1" aria-hidden="true">
            <Media photo={b.photo} ratio={b.ratio ?? '4 / 3'} sizes="(min-width: 900px) 45vw, 100vw" />
          </a>
        </div>
      );
    }
    if (b.type === 'note') {
      return (
        <div class="container ch__block ch__note-block">
          <p class="ch__small-note" set:html={renderInline(b.text)} />
        </div>
      );
    }
    if (b.type === 'links') {
      return (
        <div class="container ch__block ch__links">
          {b.heading && <p class="eyebrow eyebrow--muted">{b.heading}</p>}
          <ul class="ch__links-list">
            {b.items.map((l) => (
              <li>
                <a class="link-arrow" href={withBase(l.href)}>{l.label} <Icon name="arrow-right" /></a>
              </li>
            ))}
          </ul>
        </div>
      );
    }
    if (b.type === 'sequence') {
      return (
        <div class="container ch__block">
          <Sequence heading={b.heading} intro={b.intro} stages={b.stages} />
        </div>
      );
    }
    if (b.type === 'audio') {
      return (
        <div class="container ch__block">
          <section class="ch__audio" aria-labelledby={b.heading ? hid : undefined}>
            {b.eyebrow && <p class="ch__quote-eyebrow">{b.eyebrow}</p>}
            {b.heading && <h2 id={hid} class="title-md ch__audio-title">{b.heading}</h2>}
            {b.intro && (
              <div class="ch__audio-intro">
                {b.intro.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
              </div>
            )}
            <div class="ch__audio-tracks">
              {b.tracks.map((t) => (
                <div class="ch__track">
                  <h3 class="ch__track-title">{t.title}</h3>
                  {t.subtitle && <p class="ch__track-sub">{t.subtitle}</p>}
                  <audio controls preload="none" src={withBase(t.src)} data-ch-audio aria-label={t.title}></audio>
                  {t.transcript && t.transcript.length > 0 ? (
                    <div class="ch__transcript">
                      <p class="ch__transcript-label">Transcript</p>
                      {t.transcript.map((line) => <p>{line}</p>)}
                    </div>
                  ) : (
                    <p class="ch__transcript-pending">Transcript to follow.</p>
                  )}
                </div>
              ))}
            </div>
            {b.note && <p class="ch__audio-note">{b.note}</p>}
          </section>
        </div>
      );
    }
    if (b.type === 'document') {
      const zoomable = photoExists(b.preview.src);
      const ratio = b.preview.width && b.preview.height ? `${b.preview.width} / ${b.preview.height}` : '4 / 3';
      const media = <Media photo={b.preview} ratio={ratio} sizes="(min-width: 960px) 60vw, 100vw" />;
      return (
        <div class="container ch__block ch__doc">
          <div class="ch__doc-copy">
            {b.heading && <h3 class="title-md ch__doc-title" id={hid}>{b.heading}</h3>}
            {b.paragraphs && (
              <div class="prose">
                {b.paragraphs.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
              </div>
            )}
            <a class="btn" href={withBase(b.download.href)} download>{b.download.label} <Icon name="arrow-right" /></a>
          </div>
          <figure class="ch__figure ch__doc-figure">
            {zoomable ? (
              <a class="ch__zoom" href={withBase(b.preview.src!)} data-lightbox data-caption={b.caption?.title ?? b.preview.alt ?? ''}>
                {media}
              </a>
            ) : (
              media
            )}
            {b.caption && (
              <figcaption class="ch__caption">
                <span class="ch__cap-title">{b.caption.title}</span>
                {b.caption.note && <span class="ch__cap-note">{b.caption.note}</span>}
              </figcaption>
            )}
          </figure>
        </div>
      );
    }
    if (b.type === 'faq') {
      return (
        <div class="container ch__block ch__faq">
          {b.heading && <h2 id={hid} class="title-lg ch__faq-title">{b.heading}</h2>}
          {b.intro && (
            <div class="prose">
              {b.intro.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
            </div>
          )}
          <div class="ch__faq-list">
            {b.items.map((it) => (
              <details class="ch__faq-item">
                <summary class="ch__faq-q"><span>{it.q}</span><span class="ch__faq-icon" aria-hidden="true"></span></summary>
                <div class="prose ch__faq-a">
                  {it.a.map((p) => (hasInline(p) ? <p set:html={renderInline(p)} /> : <p>{p}</p>))}
                </div>
              </details>
            ))}
          </div>
        </div>
      );
    }
    if (b.type === 'ratings') {
      return (
        <div class="container ch__block ch__ratings">
          <p class="ch__ratings-statement">{b.statement}</p>
          <ul class="ch__ratings-grid">
            {b.items.map((it) => (
              <li class="ch__rating">
                <span class="ch__rating-platform">{it.platform}</span>
                <span class="ch__rating-value">{it.rating}</span>
                {it.detail && <span class="ch__rating-detail">{it.detail}</span>}
              </li>
            ))}
          </ul>
          {b.note && <p class="ch__caption">{b.note}</p>}
        </div>
      );
    }
    if (b.type === 'reviews') {
      return (
        <div class="container ch__block ch__reviews">
          {b.heading && (
            <div class="split">
              <h2 id={hid} class="title-lg">{b.heading}</h2>
              {b.paragraphs && <div class="prose">{b.paragraphs.map((p) => <p>{p}</p>)}</div>}
            </div>
          )}
          <ul class="ch__reviews-grid" aria-labelledby={b.heading ? hid : undefined}>
            {b.items.map((r) => (
              <li>
                <figure class="ch__review">
                  <p class="ch__review-score">{r.score}</p>
                  <blockquote class="ch__review-text">{r.quote}</blockquote>
                  <figcaption class="ch__review-attr">
                    <span class="ch__review-author">{r.author}</span>
                    <span class="ch__review-source">{[r.source, r.date].filter(Boolean).join(' · ')}</span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      );
    }
    if (b.type === 'quote') {
      return (
        <div class="container ch__block">
          <section class="ch__quote" aria-labelledby={hid}>
            <div class="ch__quote-copy">
              {b.eyebrow && <p class="ch__quote-eyebrow">{b.eyebrow}</p>}
              <h2 id={hid} class="title-lg ch__quote-title">{b.heading}</h2>
              {b.paragraphs?.map((p) => (hasInline(p) ? <p class="ch__quote-p" set:html={renderInline(p)} /> : <p class="ch__quote-p">{p}</p>))}
            </div>
            <figure class="ch__quote-fig">
              <blockquote class="ch__quote-text">{b.quote}</blockquote>
              <figcaption class="ch__quote-attr">{b.attribution}</figcaption>
              {b.cta && (
                <a
                  class="btn ch__quote-btn"
                  href={b.cta.external ? b.cta.href : withBase(b.cta.href)}
                  target={b.cta.external ? '_blank' : undefined}
                  rel={b.cta.external ? 'noopener noreferrer' : undefined}
                >
                  {b.cta.label} <Icon name="arrow-ext" />
                  {b.cta.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              )}
            </figure>
          </section>
        </div>
      );
    }
    return null;
  })}
</section>

<script>
  for (const list of document.querySelectorAll<HTMLElement>('[data-strip]')) {
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ch__strip-btn');
      if (!btn) return;
      const open = btn.getAttribute('aria-pressed') === 'true';
      for (const b of list.querySelectorAll('.ch__strip-btn')) b.setAttribute('aria-pressed', 'false');
      btn.setAttribute('aria-pressed', open ? 'false' : 'true');
    });
  }
</script>

<script>
  // One recording at a time: starting a player pauses the others.
  document.addEventListener('play', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLAudioElement) || !t.hasAttribute('data-ch-audio')) return;
    for (const a of document.querySelectorAll<HTMLAudioElement>('audio[data-ch-audio]')) if (a !== t) a.pause();
  }, true);
</script>

<style>
  .ch {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
  }
  .ch__block {
    min-width: 0;
  }

  .ch__aside {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .ch__aside-figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }
  .ch__aside--center {
    align-items: center;
  }
  .ch__aside-figure :global(.ch__aside-more) {
    margin-top: 0.75rem;
  }

  /* Tiles: square cards side by side (About's community stories). */
  .ch__tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--tile-cols, 2), minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: 0;
    margin: 0;
  }
  .ch__tile {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    min-width: 0;
  }
  .ch__tile-media {
    display: block;
    min-width: 0;
  }
  .ch__tile-copy {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .ch__tile-title {
    max-width: 18ch;
  }
  .ch__tile-copy .prose p {
    font-size: 0.9375rem;
  }
  @media (max-width: 699px) {
    .ch__tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .ch__figure {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .ch__bleed {
    width: 100%;
  }
  .ch__bleed .ch__figure :global(.media),
  .ch__bleed .ch__figure :global(.slot) {
    max-height: 88vh;
  }
  .ch__bleed .ch__caption {
    padding-inline: var(--gutter);
  }
  .ch__caption {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    white-space: pre-line;
  }
  /* Titled captions: a small uppercase title with a muted note under it (matches Gallery). */
  .ch__cap-title {
