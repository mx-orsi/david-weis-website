---
/** MarketCard — one of the three markets on the home page (section 3). */
import Icon from './Icon.astro';
import Media from './Media.astro';
import type { Market } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  market: Market;
}
const { market: m } = Astro.props;
const href = withBase(m.href);
---

<article class="mc" aria-labelledby={`market-${m.slug}`}>
  <a class="mc__media" href={href} tabindex="-1" aria-hidden="true">
    <Media photo={m.image} ratio="4 / 5" sizes="(min-width: 1024px) 33vw, (min-width: 700px) 50vw, 100vw" />
  </a>
  <div class="mc__body">
    <h3 class="mc__title" id={`market-${m.slug}`}><a href={href}>{m.name}</a></h3>
    <p class="mc__blurb">{m.homeBlurb}</p>
    <a class="link-arrow" href={href}>{m.homeCta} <Icon name="arrow-right" /></a>
  </div>
</article>

<style>
  .mc {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    min-width: 0;
  }
  .mc__media {
    display: block;
  }
  .mc__body {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
  .mc__title {
    font-size: clamp(2rem, 3vw, 2.6rem);
    line-height: 1;
  }
  .mc__title a {
    text-decoration: none;
  }
  .mc__title a:hover {
    color: var(--blue);
  }
  .mc__blurb {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 40ch;
  }
</style>
