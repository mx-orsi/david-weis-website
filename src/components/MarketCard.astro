---
import Icon from './Icon.astro';
import SearchCTA from './SearchCTA.astro';
import type { Market } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  market: Market;
}
const { market } = Astro.props;
---

<article class="market-card" style={`--accent: ${market.accent}`} aria-labelledby={`market-${market.slug}`}>
  <div class="market-card__inner">
  <div class="market-card__media">
    <img src={withBase(market.image.src)} alt={market.image.alt} width="800" height="600" loading="lazy" decoding="async" />
  </div>
  <div class="market-card__body">
    <div class="market-card__head">
      <p class="eyebrow eyebrow--dot">{market.region}</p>
      <span class="pill">{market.pill}</span>
    </div>
    <h3 class="market-card__title" id={`market-${market.slug}`}>
      <a href={withBase(market.href)}>{market.name}</a>
    </h3>
    <p class="market-card__tagline">{market.tagline}</p>
    <p class="market-card__blurb">{market.blurb}</p>
    <ul class="market-card__list">
      {market.bullets.map((b) => <li>{b}</li>)}
    </ul>
    <div class="market-card__actions">
      <a class="link-arrow" href={withBase(market.href)}>
        View {market.shortName} <Icon name="arrow-right" />
      </a>
      <SearchCTA market={market.slug} variant="link" class="market-card__search" />
    </div>
  </div>
  </div>
</article>

<style>
  .market-card {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .market-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--line-strong);
  }
  .market-card__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .market-card__media {
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .market-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .market-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem 1.6rem 1.5rem;
    gap: 0.6rem;
  }
  .market-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.2rem;
  }
  .market-card__title {
    font-size: 1.9rem;
    line-height: 1;
  }
  .market-card__title a {
    text-decoration: none;
  }
  .market-card__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .market-card__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ink-2);
    margin-top: -0.2rem;
  }
  .market-card__blurb {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-2);
    margin-top: 0.4rem;
  }
  .market-card__list {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    margin-top: 0.6rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink);
  }
  .market-card__list li {
    position: relative;
    padding-left: 1.1rem;
  }
  .market-card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.85;
  }
  .market-card__actions {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.3rem;
  }
  .market-card__search {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }
  .market-card__search:hover {
    color: var(--ink);
  }
</style>

<style>
  /* When a card is given a wide slot (e.g. the orphan card on tablet), go horizontal. */
  @container (min-width: 600px) {
    .market-card__inner {
      flex-direction: row;
    }
    .market-card__media {
      width: 42%;
      flex: none;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .market-card__body {
      padding: 2rem 2.25rem;
    }
  }
</style>
