---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import SearchCTA from './SearchCTA.astro';
import { nav } from '../data/site';
import { withBase } from '../lib/paths';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === (withBase(href).replace(/\/$/, '') || '/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={withBase('/')} class="site-header__brand" aria-label="David Weis, Broker Associate and REALTOR® — home">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list" id="site-nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <SearchCTA variant="nav" />
        </li>
      </ul>
    </nav>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-list"
      aria-label="Open menu"
    >
      <Icon name="menu" size={22} class="site-header__icon site-header__icon--menu" />
      <Icon name="close" size={22} class="site-header__icon site-header__icon--close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.site-header__toggle');

  function setOpen(open: boolean) {
    if (!header || !toggle) return;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('is-open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 245, 240, 0.86);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 76px;
  }
  .site-header__brand {
    text-decoration: none;
    flex: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    list-style: none;
  }
  .site-nav__list a:not(.btn) {
    font-weight: 400;
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--ink-2);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .site-nav__list a:not(.btn):hover {
    color: var(--ink);
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .site-nav__cta {
    margin-left: 0.5rem;
  }

  .site-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    cursor: pointer;
  }
  .site-header__icon--close {
    display: none;
  }
  .site-header.is-open .site-header__icon--close {
    display: block;
  }
  .site-header.is-open .site-header__icon--menu {
    display: none;
  }

  @media (max-width: 899px) {
    .site-header__toggle {
      display: inline-flex;
    }
    .site-nav {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -28px rgba(22, 24, 27, 0.35);
      display: none;
    }
    .site-header.is-open .site-nav {
      display: block;
    }
    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      padding-block: 0.5rem 1.25rem;
    }
    .site-nav__list li {
      border-bottom: 1px solid var(--line);
    }
    .site-nav__list li:last-child {
      border-bottom: 0;
    }
    .site-nav__list a:not(.btn) {
      display: block;
      padding-block: 0.95rem;
      font-size: 1rem;
      border-bottom: 0;
    }
    .site-nav__list a[aria-current='page'] {
      border-bottom: 0;
      font-weight: 500;
    }
    .site-nav__cta {
      margin: 1rem 0 0;
    }
    .site-nav__cta .btn {
      width: 100%;
    }
  }
</style>
