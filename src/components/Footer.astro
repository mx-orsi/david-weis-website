---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import PcbTrace from './PcbTrace.astro';
import Title from './Title.astro';
import { agent, markets, legal } from '../data/site';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <PcbTrace variant="divider" class="site-footer__trace" />

    <div class="site-footer__grid">
      <div class="site-footer__lockup">
        <Logo variant="lockup" />
      </div>

      <nav class="site-footer__col" aria-label="Markets">
        <h2 class="eyebrow">Markets</h2>
        <ul>
          {markets.map((m) => <li><a href={withBase(m.href)}>{m.name}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Explore">
        <h2 class="eyebrow">Explore</h2>
        <ul>
          <li><a href={withBase('/projects')}>Projects</a></li>
          <li><a href={withBase('/contact')}>Contact</a></li>
          <li>
            <a href={agent.compassProfile} target="_blank" rel="noopener noreferrer" class="site-footer__ext">
              Search Homes on Compass <Icon name="arrow-ext" size={12} /><span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={agent.vacationRentals.url} target="_blank" rel="noopener noreferrer" class="site-footer__ext">
              Vacation rentals: {agent.vacationRentals.name} <Icon name="arrow-ext" size={12} /><span class="sr-only">(opens in a new tab)</span>
            </a>
            <span class="site-footer__note">Independently operated. Compass is not involved in rentals.</span>
          </li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="eyebrow">Connect</h2>
        <ul>
          <li><a href={agent.phoneHref}>{agent.phone}</a></li>
          <li><a href={`mailto:${agent.email}`}>{agent.email}</a></li>
          <li>{agent.office.street}<br />{agent.office.city}, {agent.office.state} {agent.office.zip}</li>
        </ul>
        <ul class="site-footer__social" aria-label="Social">
          <li><a href={agent.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="David Weis on Instagram (opens in a new tab)"><Icon name="instagram" size={18} /></a></li>
          <li><a href={agent.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="David Weis on LinkedIn (opens in a new tab)"><Icon name="linkedin" size={18} /></a></li>
          <li><a href={agent.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="David Weis on Facebook (opens in a new tab)"><Icon name="facebook" size={18} /></a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      <div class="site-footer__marks">
        <img src={withBase('/images/equal-housing-opportunity-logo.png')} alt="Equal Housing Opportunity" width="481" height="514" loading="lazy" decoding="async" />
        <img src={withBase('/images/realtor-logo.png')} alt="REALTOR®" width={248} height={286} loading="lazy" decoding="async" />
      </div>
      <p class="site-footer__lines">
        <span>{agent.name} | <Title /> | CA DRE #{agent.dre}</span>
        <span>{legal.officeLine}</span>
        <span>{legal.brokerLine}</span>
      </p>
      <p class="site-footer__disclaimer">{legal.disclaimer}</p>
      <p class="site-footer__copy">© {year} {agent.name} · <Title /> · CA DRE #{agent.dre}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 3rem;
  }
  .site-footer__trace {
    margin-bottom: 3rem;
    opacity: 0.9;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 0.9fr 1.3fr 1.1fr;
    gap: 3rem 2rem;
  }
  .site-footer__lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .site-footer__col a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .site-footer__col a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .site-footer__ext {
    display: inline;
  }
  .site-footer__ext svg {
    display: inline-block;
    vertical-align: -0.05em;
    margin-left: 0.3em;
  }
  .site-footer__note {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .site-footer__social {
    display: flex !important;
    justify-content: start;
    gap: 0.6rem !important;
    margin-top: 1.25rem !important;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-control);
    border-radius: 999px;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .site-footer__social a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .site-footer__legal {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .site-footer__marks {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .site-footer__marks img {
    height: 44px;
    width: auto;
  }
  .site-footer__lines {
    display: grid;
    gap: 0.15rem;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 400;
  }
  .site-footer__disclaimer {
    max-width: 78ch;
  }

  @media (max-width: 899px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__lockup {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 540px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }
</style>
