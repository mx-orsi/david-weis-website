---
/**
 * Global footer, per the copy deck: David's identity block (name, title,
 * DRE, Compass, markets), links, direct contact and social, then the
 * brokerage compliance band and the copyright line with the Privacy Policy.
 */
import Logo from './Logo.astro';
import CompassLogo from './CompassLogo.astro';
import Icon from './Icon.astro';
import PcbTrace from './PcbTrace.astro';
import Title from './Title.astro';
import { agent, legal, social } from '../data/site';
import { footerLinks } from '../data/nav';
import { withBase } from '../lib/paths';

const socialLinks = social.filter((s) => s.href);
---

<footer class="ftr">
  <div class="container">
    <PcbTrace variant="divider" class="ftr__trace" />

    <div class="ftr__grid">
      <div class="ftr__brand">
        <Logo />
        <p class="ftr__id">
          <span class="ftr__name">{agent.name}</span>
          <span><Title /></span>
          <span>CA DRE #{agent.dre}</span>
        </p>
        <p class="ftr__compass">
          <CompassLogo class="ftr__compass-mark" />
        </p>
        <p class="ftr__markets">San Diego · Palm Springs · Big Bear</p>
      </div>

      <nav class="ftr__col" aria-label="Footer">
        <h2 class="eyebrow eyebrow--muted">Explore</h2>
        <ul>
          {footerLinks.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="ftr__col">
        <h2 class="eyebrow eyebrow--muted">Connect</h2>
        <ul>
          <li><span class="ftr__k">M:</span> <a href={agent.phoneHref}>{agent.phone}</a></li>
          <li><a href={`mailto:${agent.email}`}>{agent.email}</a></li>
        </ul>
        {socialLinks.length > 0 && (
          <ul class="ftr__social" aria-label="Social">
            {socialLinks.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  <Icon name={s.icon} size={15} /> {s.name}<span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="ftr__legal">
      <div class="ftr__marks">
        <img src={withBase('/images/equal-housing-opportunity-logo.png')} alt="Equal Housing Opportunity" width="481" height="514" loading="lazy" decoding="async" />
        <img src={withBase('/images/realtor-logo.png')} alt="REALTOR®" width="248" height="286" loading="lazy" decoding="async" />
      </div>
      <div class="ftr__disclosure">
        <p class="ftr__broker">{legal.brokerLine}</p>
        <p class="ftr__disclaimer">{legal.disclaimer}</p>
      </div>
    </div>

    <div class="ftr__bottom">
      <p>{legal.copyright}</p>
      <a href={withBase('/privacy-policy')}>Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 2.5rem;
  }
  .ftr__trace {
    margin-bottom: 3.5rem;
  }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: 3rem 2.5rem;
    align-items: start;
  }
  .ftr__brand {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .ftr__id {
    display: grid;
    gap: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .ftr__name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ftr__compass {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ftr__compass :global(.ftr__compass-mark) {
    height: 14px;
  }
  .ftr__markets {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ftr__col ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-top: 1.1rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .ftr__col a {
    text-decoration: none;
    color: var(--ink-2);
  }
  .ftr__col a:hover {
    color: var(--blue);
  }
  .ftr__k {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ftr__social {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.5rem !important;
    margin-top: 1.25rem !important;
  }
  .ftr__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.5em 0.9em;
    border: 1px solid var(--line-control);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .ftr__social a:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .ftr__legal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: start;
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .ftr__marks {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .ftr__marks img {
    height: 64px;
    width: auto;
  }
  .ftr__disclosure {
    display: grid;
    gap: 0.6rem;
    max-width: 78ch;
  }
  .ftr__broker {
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }
  .ftr__disclaimer {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .ftr__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .ftr__bottom a {
    text-decoration: none;
    color: var(--ink-2);
    font-weight: 400;
  }
  .ftr__bottom a:hover {
    color: var(--blue);
  }

  @media (max-width: 899px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
    .ftr__legal {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .ftr__grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .ftr__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
