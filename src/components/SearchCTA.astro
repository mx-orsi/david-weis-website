---
/**
 * SearchCTA — every outbound link to Compass listings renders here.
 * Compass has no embeddable IDX for personal agent sites, so this links out:
 *   • no `market` → David's Compass profile ("View all listings on Compass")
 *   • `market="san-diego"` etc. → Compass consumer search for that area, with
 *     the market's "Explore … Properties" label from site.ts
 * If an IDX embed becomes available, replace the markup and keep the props.
 */
import Icon from './Icon.astro';
import { agent, getMarket, type MarketSlug } from '../data/site';

interface Props {
  market?: MarketSlug;
  variant?: 'primary' | 'ghost' | 'light' | 'outline-light' | 'link';
  label?: string;
  class?: string;
}

const { market, variant = 'primary', label, class: className, ...rest } = Astro.props;
const m = market ? getMarket(market) : undefined;
const href = m ? m.searchHref : agent.compassProfile;
const text = label ?? (m ? m.propertiesCta : 'View all listings on Compass');
const isLink = variant === 'link';
const classes = isLink ? ['link-arrow', 'link-arrow--ext', className] : ['btn', variant === 'primary' ? '' : `btn--${variant}`, className];
---

<a href={href} class:list={classes} target="_blank" rel="noopener noreferrer" data-search-cta={m?.slug ?? 'all'} {...rest}>
  <span>{text}</span>
  <Icon name="arrow-ext" />
  <span class="sr-only">(opens Compass in a new tab)</span>
</a>
