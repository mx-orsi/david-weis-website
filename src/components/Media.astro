---
/**
 * Media — renders a real photo when the Photo has a `src`, otherwise a
 * labeled placeholder (PhotoSlot) that prints the suggested shot. Every
 * image slot on the site goes through this component so a photo can be
 * dropped in by editing data only. When a .webp sibling exists (npm run
 * images) it is offered first through <picture>.
 */
import PhotoSlot from './PhotoSlot.astro';
import type { Photo } from '../data/types';
import { withBase } from '../lib/paths';
import { sizedVariant, webpVariant } from '../lib/images';

interface Props {
  photo: Photo;
  /** CSS aspect ratio, e.g. "4 / 3", "16 / 9", "21 / 9" */
  ratio?: string;
  sizes?: string;
  /** Above-the-fold image: eager + high priority */
  priority?: boolean;
  class?: string;
}
const { photo, ratio = '4 / 3', sizes = '(min-width: 1024px) 50vw, 100vw', priority = false, class: className } = Astro.props;

const src = photo.src ? withBase(photo.src) : undefined;
const small = photo.src && photo.hasSmall ? withBase(sizedVariant(photo.src, 800)) : undefined;
const webp = webpVariant(photo.src);
const webpSmall = webp && photo.hasSmall ? webpVariant(sizedVariant(photo.src!, 800)) : undefined;
const webpSet = webp ? (webpSmall ? `${withBase(webpSmall)} 800w, ${withBase(webp)} 1600w` : withBase(webp)) : undefined;
---

{src ? (
  <figure class:list={['media', 'frame', className]} style={`aspect-ratio: ${ratio}`}>
    <picture>
      {webpSet && <source type="image/webp" srcset={webpSet} sizes={webpSmall ? sizes : undefined} />}
      <img
        src={src}
        srcset={small ? `${small} 800w, ${src} 1600w` : undefined}
        sizes={small ? sizes : undefined}
        alt={photo.alt ?? ''}
        width={photo.width}
        height={photo.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    </picture>
  </figure>
) : (
  <PhotoSlot suggestion={photo.suggestion} ratio={ratio} class={className} />
)}

<style>
  .media {
    margin: 0;
    width: 100%;
  }
  .media picture,
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
