---
/**
 * Media — renders a real photo when the Photo has a `src`, otherwise a
 * labeled placeholder (PhotoSlot) that prints the suggested shot. Every
 * image slot on the site goes through this component so a photo can be
 * dropped in by editing data only. When a .webp sibling exists (npm run
 * images) it is offered first through <picture>.
 *
 * A Photo may name a `src` that is not in public/ yet (the data is written
 * ahead of the upload). In that case the placeholder renders and prints the
 * expected filename, so dropping the file in is all it takes.
 */
import PhotoSlot from './PhotoSlot.astro';
import type { Photo } from '../data/types';
import { withBase } from '../lib/paths';
import { photoExists, sizedVariant, webpVariant } from '../lib/images';

interface Props {
  photo: Photo;
  /** CSS aspect ratio, e.g. "4 / 3", "16 / 9", "21 / 9" */
  ratio?: string;
  sizes?: string;
  /** Above-the-fold image: eager + high priority */
  priority?: boolean;
  class?: string;
}
const { photo, ratio = '4 / 3', sizes = '(min-width: 1024px) 50vw, 100vw', priority = false, class: className } = Astro.props;

const onDisk = photoExists(photo.src);
const src = onDisk ? withBase(photo.src!) : undefined;
const webp = onDisk ? webpVariant(photo.src) : undefined;

/**
 * Size ladder: -800 and -1600 variants when they exist (npm run images), then
 * the full file at its real width. Browsers pick the smallest that fits.
 */
const fullWidth = photo.width && photo.width > 1600 ? photo.width : 1600;
const ladder = (base: string, toVariant: (p: string) => string | undefined) => {
  if (!photo.hasSmall) return undefined;
  const steps: string[] = [];
  for (const w of [800, 1600]) {
    const v = toVariant(sizedVariant(photo.src!, w));
    if (v && w < fullWidth) steps.push(`${withBase(v)} ${w}w`);
  }
  steps.push(`${base} ${fullWidth}w`);
  return steps.length > 1 ? steps.join(', ') : undefined;
};
const small = onDisk ? ladder(src!, (p) => (photoExists(p) ? p : undefined)) : undefined;
const webpSet = webp ? ladder(withBase(webp), (p) => webpVariant(p)) ?? withBase(webp) : undefined;
---

{src ? (
  <figure class:list={['media', 'frame', className]} style={`aspect-ratio: ${ratio}`}>
    <picture>
      {webpSet && <source type="image/webp" srcset={webpSet} sizes={small ? sizes : undefined} />}
      <img
        src={src}
        srcset={small}
        sizes={small ? sizes : undefined}
        alt={photo.alt ?? ''}
        width={photo.width}
        height={photo.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        style={photo.position ? `object-position: ${photo.position}` : undefined}
      />
    </picture>
  </figure>
) : (
  <PhotoSlot suggestion={photo.suggestion} file={photo.src} ratio={ratio} class={className} />
)}

<style>
  .media {
    margin: 0;
    width: 100%;
  }
  .media picture,
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
