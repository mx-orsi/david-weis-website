---
import PcbTrace from './PcbTrace.astro';
import SearchCTA from './SearchCTA.astro';
import { withBase } from '../lib/paths';
import type { MarketSlug } from '../data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  /** Point the search button at one market's Compass search */
  market?: MarketSlug;
  /** dark (default) ink band, or a light card */
  tone?: 'dark' | 'light';
}
const {
  eyebrow = 'Buying · Selling · Investing',
  title = 'One conversation, three markets',
  body = "Whether you're weighing a La Jolla condo, a Palm Springs mid-century or a Big Bear cabin, start with someone who owns and operates in all three.",
  market,
  tone = 'dark',
} = Astro.props;
---

<section class="cta section section--tight" aria-labelledby="cta-title">
  <div class="container">
    <div class:list={["cta__card", `cta__card--${tone}`]}>
      <PcbTrace variant="corner" class="cta__trace cta__trace--tl" />
      <PcbTrace variant="corner" class="cta__trace cta__trace--br" />
      <div class="cta__copy">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="cta-title">{title}</h2>
        <p>{body}</p>
      </div>
      <div class="cta__actions">
        {tone === 'dark' ? (
          <>
            <SearchCTA variant="light" market={market} />
            <a class="btn btn--outline-light" href={withBase('/contact')}>Contact David</a>
          </>
        ) : (
          <>
            <a class="btn" href={withBase('/contact')}>Contact David</a>
            <SearchCTA variant="ghost" market={market} />
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta__card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 2.5rem;
    padding: clamp(2.25rem, 5vw, 3.75rem);
    background: var(--surface-ink);
    color: var(--on-ink);
    border-radius: var(--radius-lg);
  }
  .cta__copy {
    display: grid;
    gap: 0.9rem;
  }
  .cta__copy .eyebrow {
    color: var(--on-ink-muted);
  }
  .cta__copy h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
  }
  .cta__copy p:not(.eyebrow) {
    color: var(--on-ink-muted);
    font-size: 1rem;
    max-width: 36rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta__trace {
    position: absolute;
    color: rgba(247, 245, 240, 0.28);
  }
  .cta__card--light {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .cta__card--light .cta__copy .eyebrow,
  .cta__card--light .cta__copy p:not(.eyebrow) {
    color: var(--ink-2);
  }
  .cta__card--light .cta__trace {
    color: var(--line-strong);
  }
  .cta__trace--tl {
    top: 1.25rem;
    right: -0.5rem;
    transform: scaleX(-1);
  }
  .cta__trace--br {
    bottom: 1.25rem;
    right: -0.5rem;
    transform: rotate(180deg);
  }

  @media (max-width: 899px) {
    .cta__card {
      grid-template-columns: 1fr;
    }
  }
</style>
