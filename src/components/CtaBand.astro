---
import PcbTrace from './PcbTrace.astro';
import SearchCTA from './SearchCTA.astro';
import { withBase } from '../lib/paths';
---

<section class="cta section section--tight" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__card">
      <PcbTrace variant="corner" class="cta__trace cta__trace--tl" />
      <PcbTrace variant="corner" class="cta__trace cta__trace--br" />
      <div class="cta__copy">
        <p class="eyebrow">Buying · Selling · Investing</p>
        <h2 id="cta-title">One conversation, three markets</h2>
        <p>
          Whether you're weighing a La Jolla condo, a Palm Springs mid-century or a Big Bear cabin,
          start with someone who owns and operates in all three.
        </p>
      </div>
      <div class="cta__actions">
        <SearchCTA variant="light" />
        <a class="btn btn--outline-light" href={withBase('/contact')}>Contact David</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    align-items: center;
    gap: 2.5rem;
    padding: clamp(2.25rem, 5vw, 3.75rem);
    background: var(--surface-ink);
    color: var(--on-ink);
    border-radius: var(--radius-lg);
  }
  .cta__copy {
    display: grid;
    gap: 0.9rem;
  }
  .cta__copy .eyebrow {
    color: var(--on-ink-muted);
  }
  .cta__copy h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
  }
  .cta__copy p:not(.eyebrow) {
    color: var(--on-ink-muted);
    font-size: 1rem;
    max-width: 36rem;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta__trace {
    position: absolute;
    color: rgba(247, 245, 240, 0.28);
  }
  .cta__trace--tl {
    top: 1.25rem;
    right: -0.5rem;
    transform: scaleX(-1);
  }
  .cta__trace--br {
    bottom: 1.25rem;
    right: -0.5rem;
    transform: rotate(180deg);
  }

  @media (max-width: 899px) {
    .cta__card {
      grid-template-columns: 1fr;
    }
  }
</style>
