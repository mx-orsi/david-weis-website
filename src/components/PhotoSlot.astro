---
/**
 * PhotoSlot — a clearly labeled placeholder where a photo will go. Each slot
 * prints the suggested subject so David can read the page and decide which
 * of his photos fits. Media.astro swaps it for an <img> once a Photo has a src.
 */
interface Props {
  /** Suggested subject for the photo, shown inside the slot */
  suggestion: string;
  /** CSS aspect ratio, e.g. "4 / 5" or "16 / 9" */
  ratio?: string;
  class?: string;
}
const { suggestion, ratio = '4 / 3', class: className } = Astro.props;
---

<figure class:list={['slot', className]} style={`--ratio: ${ratio}`} role="img" aria-label={`Photo placeholder: ${suggestion}`}>
  <div class="slot__inner">
    <svg class="slot__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2l1.2-1.8A1 1 0 0 1 9.5 4.7h5a1 1 0 0 1 .8.5L16.5 7h2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-9Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
      <circle cx="12" cy="13" r="3.2" stroke="currentColor" stroke-width="1.3" />
    </svg>
    <span class="slot__label">Photo placeholder</span>
    <span class="slot__text">{suggestion}</span>
  </div>
</figure>

<style>
  .slot {
    aspect-ratio: var(--ratio);
    width: 100%;
    min-width: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: var(--surface-2);
    border: 1px dashed var(--line-control);
    color: var(--ink-2);
    text-align: center;
  }
  .slot__inner {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    max-width: 28ch;
  }
  .slot__icon {
    width: 26px;
    height: 26px;
    color: var(--muted);
  }
  .slot__label {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .slot__text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
</style>
