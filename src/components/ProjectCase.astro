---
import Icon from './Icon.astro';
import PhotoSlot from './PhotoSlot.astro';
import type { Project } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props {
  project: Project;
}
const { project: p } = Astro.props;
/** With a logo, all photos go in the bottom row; without one, the first photo leads the media column. */
const lead = p.logo ? null : p.photos[0];
const gallery = p.logo ? p.photos : p.photos.slice(1);
---

<article class="case" id={p.slug} aria-labelledby={`case-${p.slug}`}>
  <div class="case__media">
    {p.logo ? (
      <div class="case__logo">
        <img src={withBase(p.logo.src)} alt={p.logo.alt} width={p.logo.width} height={p.logo.height} loading="lazy" decoding="async" />
      </div>
    ) : (
      lead && <PhotoSlot suggestion={lead} ratio="4 / 3" class="case__lead" />
    )}
    {p.results && (
      <ul class="case__results" aria-label="Highlights">
        {p.results.map((r) => (
          <li>
            <strong>{r.value}</strong>
            <span>{r.label}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="case__body">
    <p class="eyebrow eyebrow--dot">{p.market} · {p.kind}</p>
    <h2 class="case__title" id={`case-${p.slug}`}>{p.name}</h2>
    <p class="case__role">{p.role}</p>
    <p class="case__summary">{p.summary}</p>
    {p.body.map((para) => <p class="case__p">{para}</p>)}
    <dl class="case__facts">
      {p.facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
    {p.link && (
      <a class="link-arrow link-arrow--ext" href={p.link.href} target="_blank" rel="noopener noreferrer">
        {p.link.label} <Icon name="arrow-ext" /><span class="sr-only">(opens in a new tab)</span>
      </a>
    )}
  </div>

  {gallery.length > 0 && (
    <div class="case__gallery" aria-label="Photo placeholders">
      {gallery.map((s) => <PhotoSlot suggestion={s} ratio="4 / 3" />)}
    </div>
  )}
</article>

<style>
  .case {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    scroll-margin-top: 6rem;
  }
  .case__media {
    display: grid;
    gap: 1.25rem;
  }
  .case__logo {
    display: grid;
    place-items: center;
    min-height: 220px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .case__logo img {
    width: min(100%, 420px);
    height: auto;
  }
  .case__results {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .case__results li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .case__results strong {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
  }
  .case__results span {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .case__body {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .case__title {
    font-size: clamp(1.9rem, 3vw, 2.5rem);
  }
  .case__role {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink-2);
    margin-top: -0.4rem;
  }
  .case__summary {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 400;
    max-width: 58ch;
  }
  .case__p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .case__facts {
    margin: 0.5rem 0 0;
    width: 100%;
    display: grid;
    gap: 0.55rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .case__facts div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .case__facts dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2em;
  }
  .case__facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  .case__gallery {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .case__gallery :global(.slot:only-child) {
    grid-column: span 2;
  }

  @media (max-width: 899px) {
    .case {
      grid-template-columns: minmax(0, 1fr);
    }
    .case__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .case__facts div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .case__gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
