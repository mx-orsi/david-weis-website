---
/**
 * StubPage — placeholder shell for pages that will be built out after the
 * home page is approved. Real heading/lede so the page is indexable and the
 * nav feels complete; a small "in progress" note keeps expectations clear.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  accent?: string;
}
const { eyebrow, title, lede, accent = 'var(--ink)' } = Astro.props;
---

<section class="stub section" style={`--accent: ${accent}`}>
  <div class="container">
    <div class="stub__grid">
      <div class="stub__copy">
        <p class="eyebrow eyebrow--dot">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{lede}</p>
        <div class="stub__actions">
          <slot name="actions" />
        </div>
      </div>
      <div class="stub__aside">
        <slot />
      </div>
    </div>
    <p class="stub__note">
      <span class="pill">In progress</span>
      <span>This page is being built out after home page approval.</span>
    </p>
  </div>
</section>

<style>
  .stub__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .stub__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .stub__copy h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    max-width: 22ch;
  }
  .stub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .stub__actions:empty {
    display: none;
  }
  .stub__note {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 899px) {
    .stub__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
