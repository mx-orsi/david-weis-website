---
/**
 * PageHero — interior page opener: breadcrumb, eyebrow, H1 and intro, with
 * optional actions and an optional media column (slot name="media").
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  crumbs?: readonly Crumb[];
  size?: 'xl' | 'display';
  id?: string;
}
const { eyebrow, title, intro, crumbs, size = 'xl', id = 'page-title' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class="ph" aria-labelledby={id}>
  <div class:list={['container', hasMedia && 'ph__grid']}>
    <div class="ph__copy">
      {crumbs && crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <p class="eyebrow eyebrow--dot">{eyebrow}</p>
      <h1 id={id} class:list={[size === 'display' ? 'display' : 'title-xl']}>{title}</h1>
      {intro && <p class="lede lede--wide">{intro}</p>}
      {Astro.slots.has('actions') && (
        <div class="ph__actions">
          <slot name="actions" />
        </div>
      )}
    </div>
    {hasMedia && (
      <div class="ph__media">
        <slot name="media" />
      </div>
    )}
  </div>
</section>

<style>
  .ph {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .ph__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: end;
  }
  .ph__copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .ph__copy h1 {
    max-width: 14ch;
  }
  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .ph__media {
    justify-self: end;
    width: 100%;
    max-width: 520px;
  }
  @media (max-width: 899px) {
    .ph__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ph__media {
      justify-self: start;
      max-width: 100%;
    }
  }
  @media (max-width: 540px) {
    .ph__actions {
      width: 100%;
      flex-direction: column;
    }
    .ph__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
