---
/** GuideCards — a list of guide cards, used by /guides and the GuideLinks teaser. */
import Icon from './Icon.astro';
import { formatGuideDate, guideHref, guidesIndex, type Guide } from '../data/guides';
import { withBase } from '../lib/paths';

interface Props {
  guides: readonly Guide[];
  /** Heading level for each card title. */
  level?: 2 | 3;
}
const { guides, level = 2 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---

<ul class="gc">
  {guides.map((g) => (
    <li class="gc__card">
      <p class="eyebrow eyebrow--muted">{g.eyebrow}</p>
      <H class="gc__title"><a href={withBase(guideHref(g))}>{g.title}</a></H>
      <p class="gc__summary">{g.summary}</p>
      <p class="gc__meta">
        <time datetime={g.published}>{formatGuideDate(g.published)}</time>
        <span class="link-arrow" aria-hidden="true">{guidesIndex.readLabel} <Icon name="arrow-right" /></span>
      </p>
    </li>
  ))}
</ul>

<style>
  .gc {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    padding: 0;
    margin: 0;
  }
  .gc__card {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line-strong);
  }
  .gc__title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .gc__title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole card is the link target. */
  .gc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .gc__card:hover .gc__title a {
    color: var(--blue);
  }
  .gc__title a:focus-visible {
    outline: none;
  }
  .gc__card:has(a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 6px;
  }
  .gc__summary {
    color: var(--ink-2);
    max-width: 52ch;
  }
  .gc__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
