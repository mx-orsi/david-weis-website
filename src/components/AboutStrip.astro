---
import Icon from './Icon.astro';
import { bio } from '../data/site';
import { withBase } from '../lib/paths';
---

<section class="about section" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__intro">
      <p class="eyebrow">About David</p>
      <h2 id="about-title">{bio.headline}</h2>
      <p class="lede">{bio.intro}</p>
      <a class="link-arrow" href={withBase('/projects')}>See the projects <Icon name="arrow-right" /></a>
    </div>
    <dl class="about__facts">
      {
        bio.facts.map((f) => (
          <div class="about__fact">
            <dt>{f.label}</dt>
            <dd>{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .about__intro {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .about__intro h2 {
    font-size: clamp(2.1rem, 3.6vw, 3rem);
  }
  .about__facts {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .about__fact {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .about__fact dt {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .about__fact dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--ink-2);
  }

  @media (max-width: 899px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 540px) {
    .about__fact {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
